// Route groups, nesting, precedence, wildcard, per-route middleware, and
// compile-time route checking.
//   printf 'GET /api/v1/users/me HTTP/1.1\r\n\r\n' | spar exec examples/routing.spar
import pkg { println } from "std/io";
import { Context } from "../src/http/context.spar";
import { Response } from "../src/http/response.spar";
import { WebError } from "../src/error/web_error.spar";
import { middleware } from "../src/middleware/middleware.spar";
import { Route, RouteGroup } from "../src/routing/route.spar";
import { App, Server } from "../src/app/app.spar";
import { serveStdio } from "../src/transport/stdio.spar";

fn me(ctx: Context) -> Response {
    return Response.text(value: "the current user");
};

fn byId(ctx: Context) -> Response {
    return Response.text(value: "user " + ctx.param(name: "id"));
};

fn comment(ctx: Context) -> Response {
    return Response.text(value: "post " + ctx.param(name: "post") + " comment " + ctx.param(name: "comment"));
};

fn assets(ctx: Context) -> Response {
    return Response.text(value: "asset " + ctx.param(name: "path"));
};

fn main() -> int {
    var versioned: RouteGroup = RouteGroup(prefix: "/v1", routes: [
        // "/users/me" wins over "/users/:id" whichever is listed first.
        Route.get(path: "/users/:id", handler: byId),
        Route.get(path: "/users/me", handler: me),
        Route.get(path: "/posts/:post/comments/:comment", handler: comment)
    ]);
    var app: App = App(
        routes: [Route.get(path: "/assets/*path", handler: assets)],
        groups: [RouteGroup(prefix: "/api", groups: [versioned])],
    );
    var compiled: Result<Server, WebError> = app.compile();
    if compiled.isErr() {
        println(value: compiled.unwrapErr().message);
        return 1;
    }
    return serveStdio(server: compiled.unwrap());
};
