import { Logger } from "../src/core/logger.spar";
import { LoggerConfig } from "../src/core/config.spar";
import { LogLevel } from "../src/core/level.spar";
import { strField, intField } from "../src/core/field.spar";
import { Sink, SinkKind, coloredConsoleSink } from "../src/sink/sink.spar";
import { Formatter, verboseFormatter } from "../src/format/formatter.spar";

fn main() -> int {
    var verbose: Sink = Sink(
        kind: SinkKind::Console,
        formatter: Formatter(style: verboseFormatter().style, color: true),
    );
    var mut logger: Logger = Logger(
        name: "compiler",
        config: LoggerConfig(level: LogLevel::Trace, sinks: [verbose]),
    );
    logger.info(message: "Build started");
    logger.warn(
        message: "Cache unavailable",
        fields: [strField(name: "dir", value: ".cache")],
    );
    logger.error(
        message: "Compilation failed",
        fields: [
            strField(name: "target", value: "android"),
            intField(name: "errors", value: 3)
        ],
    );
    return 0;
};
