import { Logger } from "../src/core/logger.spar";
import { LoggerConfig } from "../src/core/config.spar";
import { LogLevel } from "../src/core/level.spar";
import { strField, intField, floatField, boolField } from "../src/core/field.spar";
import { Sink, consoleSink } from "../src/sink/sink.spar";
import { Formatter, prettyFormatter } from "../src/format/formatter.spar";

fn main() -> int {
    var mut logger: Logger = Logger(
        name: "compiler",
        config: LoggerConfig(level: LogLevel::Trace),
    );
    logger.trace(message: "tracing");
    logger.debug(message: "debugging");
    logger.info(message: "Application started");
    logger.warn(message: "Configuration file not found");
    logger.error(message: "Build failed");
    logger.fatal(message: "Cannot continue");
    logger.info(
        message: "Build completed",
        fields: [
            strField(name: "target", value: "android"),
            strField(name: "note", value: "all good"),
            intField(name: "port", value: 8080),
            floatField(name: "duration", value: 1.4),
            boolField(name: "cached", value: true)
        ],
    );
    return 0;
};
