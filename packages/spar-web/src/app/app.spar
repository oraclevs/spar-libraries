import pkg { stringify } from "std/json";
import pkg { Logger } from "log/core/logger";
import { Context } from "../http/context.spar";
import { Request, HttpMethod, methodName } from "../http/request.spar";
import { Response } from "../http/response.spar";
import { WebError, WebErrorKind, kindName, notFound, methodNotAllowed, payloadTooLarge, errorFromCaught, configError } from "../error/web_error.spar";
import { Middleware, composeChain } from "../middleware/middleware.spar";
import { Route, RouteGroup } from "../routing/route.spar";
import { Router, Match, MatchKind, buildRouter, matchRoute } from "../routing/router.spar";

export struct AppConfig {
    host: str = "127.0.0.1";
    port: int = 8080;
    // Bodies longer than this (in characters) get 413 before any handler runs.
    requestBodyLimit: int = 1048576;
    // When true, WebError.cause is included in the default error body.
    developmentMode: bool = false;
    // Framework diagnostics (5xx causes). Off unless a logger is given.
    logErrors: bool = false;
    logger: Logger = Logger(name: "spar-web");
};

struct ErrorInfo {
    status: int = 500;
    kind: str = "";
    message: str = "";
    cause: str = "";
};

struct ErrorBody {
    error: ErrorInfo = ErrorInfo();
};

// {"error":{"status":404,"kind":"not_found","message":"Not Found"}}
fn defaultErrorHandler(error: WebError) -> Response {
    var mut cause: str = "";
    if error.metadata.getOr(key: "debug", fallback: "") == "true" {
        cause = error.cause;
    }
    var mut message: str = error.message;
    if error.status >= 500 && cause.isEmpty() && error.metadata.getOr(key: "debug", fallback: "") != "true" {
        message = "Internal Server Error";
    }
    return Response.json(value: ErrorBody(error: ErrorInfo(status: error.status, kind: kindName(kind: error.kind), message: message, cause: cause)), status: error.status);
};

fn defaultNotFound(ctx: Context) -> Response {
    return Response.fail(error: notFound());
};

// The application description. Nothing is checked or built until compile().
//   routes / groups   endpoints; groups add prefixes and shared middleware
//   middleware        global, outermost first; runs for 404/405 too
//   errorHandler      renders every WebError (default: JSON body)
//   notFound          called when no route matches (default: 404 WebError)
export struct App {
    routes: List<Route> = [];
    groups: List<RouteGroup> = [];
    middleware: List<Middleware> = [];
    config: AppConfig = AppConfig();
    errorHandler: fn(WebError) -> Response = defaultErrorHandler;
    notFound: fn(Context) -> Response = defaultNotFound;
};

// A compiled application: routes normalised, middleware chains folded once.
// handle() is transport-independent, so tests call it with constructed
// requests and no socket.
export struct Server {
    config: AppConfig = AppConfig();
    pipeline: fn(Context) -> Response = defaultNotFound;
    errorHandler: fn(WebError) -> Response = defaultErrorHandler;
};

fn middlewareProblems(layers: List<Middleware>) -> List<str> {
    var mut out: List<str> = [];
    for layer in layers {
        if !layer.error.isEmpty() {
            out.append(value: layer.error);
        }
    }
    return out;
};

fn groupProblems(group: RouteGroup) -> List<str> {
    var mut out: List<str> = middlewareProblems(layers: group.middleware);
    for route in group.routes {
        out.appendAll(values: middlewareProblems(layers: route.middleware));
    }
    for child in group.groups {
        out.appendAll(values: groupProblems(group: child));
    }
    return out;
};

// Turns a failure into the final response, keeping headers and cookies other
// layers already set (e.g. CORS headers). Rendering never throws.
fn renderFailure(res: Response, handler: fn(WebError) -> Response, config: AppConfig) -> Response {
    var mut error: WebError = res.failure;
    if config.developmentMode {
        error.metadata.insert(key: "debug", value: "true");
    }
    if config.logErrors && error.status >= 500 {
        var mut lg: Logger = config.logger;
        lg.error(message: "request failed: " + error.message + " " + error.cause);
    }
    var rendered: Response = handler(arg0: error);
    var mut merged: Map<str, str> = res.headers;
    for entry in rendered.headers.entries() {
        merged.insert(key: entry.key, value: entry.value);
    }
    var mut cookies: List<str> = res.cookies;
    cookies.appendAll(values: rendered.cookies);
    return Response(status: rendered.status, headers: merged, cookies: cookies, body: rendered.body);
};

// Runs `inner`; a thrown runtime error or a Response.fail becomes a rendered
// error response. This is the framework's error boundary.
fn guarded(inner: fn(Context) -> Response, handler: fn(WebError) -> Response, config: AppConfig) -> fn(Context) -> Response {
    return fn(ctx: Context) -> Response {
        var mut res: Response = Response();
        try {
            res = inner(arg0: ctx);
        } catch problem {
            res = Response.fail(error: errorFromCaught(caught: problem.message));
        }
        if res.failed {
            return renderFailure(res: res, handler: handler, config: config);
        }
        return res;
    };
};

fn dispatcher(router: Router, notFoundHandler: fn(Context) -> Response, handler: fn(WebError) -> Response, config: AppConfig) -> fn(Context) -> Response {
    return fn(ctx: Context) -> Response {
        var found: Match = matchRoute(router: router, method: ctx.method(), path: ctx.path());
        if found.kind == MatchKind::Found {
            var route = found.route;
            var run: fn(Context) -> Response = route.handler;
            var guardedRun: fn(Context) -> Response = guarded(inner: run, handler: handler, config: config);
            return guardedRun(arg0: ctx.withParams(params: found.params, pattern: route.pattern));
        }
        var allow: str = "";
        if found.kind == MatchKind::NotAllowed {
            var mut first: bool = true;
            for m in found.allow {
                if !first { allow = allow + ", "; }
                allow = allow + m;
                first = false;
            }
            if ctx.method() == HttpMethod::Options {
                return Response.empty(status: 204).withHeader(name: "allow", value: allow + ", OPTIONS");
            }
            var res: Response = renderFailure(res: Response.fail(error: methodNotAllowed(allow: allow)), handler: handler, config: config);
            return res.withHeader(name: "allow", value: allow);
        }
        var nf: fn(Context) -> Response = notFoundHandler;
        var guardedNf: fn(Context) -> Response = guarded(inner: nf, handler: handler, config: config);
        return guardedNf(arg0: ctx);
    };
};

impl App {
    // Validates and builds the application once. Returns every configuration
    // problem at once: duplicate or malformed routes, misconfigured middleware.
    fn compile(self) -> Result<Server, WebError> {
        var mut problems: List<str> = middlewareProblems(layers: self.middleware);
        for route in self.routes {
            problems.appendAll(values: middlewareProblems(layers: route.middleware));
        }
        for group in self.groups {
            problems.appendAll(values: groupProblems(group: group));
        }
        var built: Result<Router, WebError> = buildRouter(routes: self.routes, groups: self.groups);
        if built.isErr() {
            problems.append(value: built.unwrapErr().message);
        }
        if problems.length() > 0 {
            var mut text: str = "";
            for p in problems {
                if !text.isEmpty() { text = text + "; "; }
                text = text + p;
            }
            return err<Server, WebError>(error: configError(message: text));
        }
        var core: fn(Context) -> Response = dispatcher(router: built.unwrap(), notFoundHandler: self.notFound, handler: self.errorHandler, config: self.config);
        var pipeline: fn(Context) -> Response = composeChain(layers: self.middleware, inner: core);
        return ok<Server, WebError>(value: Server(config: self.config, pipeline: pipeline, errorHandler: self.errorHandler));
    };

    // The native SPAR runtime has no HTTP listener yet, so a TCP server cannot
    // be started from SPAR code. Use serveStdio (transport/stdio.spar) behind a
    // TCP front end such as tools/bridge.sh. Returns the reason instead of
    // pretending to listen.
    fn listen(self) -> Result<int, WebError> {
        return err<int, WebError>(error: configError(message: "no native HTTP listener in SPAR " + "(std/http is client-only); see README: Running a server"));
    };
};

impl Server {
    // Request in, Response out. Never throws: oversized bodies become 413,
    // handler failures and runtime errors become rendered error responses.
    // HEAD responses keep their headers but drop the body.
    fn handle(self, request: Request) -> Response {
        var handler: fn(WebError) -> Response = self.errorHandler;
        var mut res: Response = Response();
        if request.body.length() > self.config.requestBodyLimit {
            res = renderFailure(res: Response.fail(error: payloadTooLarge(limit: self.config.requestBodyLimit)), handler: handler, config: self.config);
        } else {
            var run: fn(Context) -> Response = self.pipeline;
            try {
                res = run(arg0: Context(request: request));
            } catch problem {
                res = Response.fail(error: errorFromCaught(caught: problem.message));
            }
            if res.failed {
                res = renderFailure(res: res, handler: handler, config: self.config);
            }
        }
        if request.method == HttpMethod::Head {
            return res.withBody(value: "");
        }
        return res;
    };
};
