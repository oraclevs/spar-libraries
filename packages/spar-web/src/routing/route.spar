import { Context } from "../http/context.spar";
import { Response } from "../http/response.spar";
import { HttpMethod } from "../http/request.spar";
import { Middleware } from "../middleware/middleware.spar";

fn noHandler(ctx: Context) -> Response {
    return Response.empty(status: 501);
};

// One endpoint. Path syntax: "/users", "/users/:id", "/files/*rest".
// `:name` matches one segment; a trailing `*name` matches one or more.
// `middleware` runs only for this route (inside any group middleware).
export struct Route {
    method: HttpMethod = HttpMethod::Get;
    path: str = "/";
    handler: fn(Context) -> Response = noHandler;
    middleware: List<Middleware> = [];
};

// Routes under a shared prefix and middleware. Groups nest through `groups`.
// Group middleware wraps every route in the group, outermost group first.
export struct RouteGroup {
    prefix: str = "";
    routes: List<Route> = [];
    middleware: List<Middleware> = [];
    groups: List<RouteGroup> = [];
};

impl Route {
    fn get(path: str, handler: fn(Context) -> Response, middleware: List<Middleware> = []) -> Route {
        return Route(method: HttpMethod::Get, path: path, handler: handler, middleware: middleware);
    };

    fn post(path: str, handler: fn(Context) -> Response, middleware: List<Middleware> = []) -> Route {
        return Route(method: HttpMethod::Post, path: path, handler: handler, middleware: middleware);
    };

    fn put(path: str, handler: fn(Context) -> Response, middleware: List<Middleware> = []) -> Route {
        return Route(method: HttpMethod::Put, path: path, handler: handler, middleware: middleware);
    };

    fn patch(path: str, handler: fn(Context) -> Response, middleware: List<Middleware> = []) -> Route {
        return Route(method: HttpMethod::Patch, path: path, handler: handler, middleware: middleware);
    };

    fn delete(path: str, handler: fn(Context) -> Response, middleware: List<Middleware> = []) -> Route {
        return Route(method: HttpMethod::Delete, path: path, handler: handler, middleware: middleware);
    };

    fn head(path: str, handler: fn(Context) -> Response, middleware: List<Middleware> = []) -> Route {
        return Route(method: HttpMethod::Head, path: path, handler: handler, middleware: middleware);
    };

    fn options(path: str, handler: fn(Context) -> Response, middleware: List<Middleware> = []) -> Route {
        return Route(method: HttpMethod::Options, path: path, handler: handler, middleware: middleware);
    };
};
