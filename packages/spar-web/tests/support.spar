import { Context } from "../src/http/context.spar";
import { Response } from "../src/http/response.spar";
import { HttpMethod, Request, makeRequest } from "../src/http/request.spar";
import { WebError } from "../src/error/web_error.spar";
import { Route } from "../src/routing/route.spar";
import { App, Server } from "../src/app/app.spar";

fn okText(ctx: Context) -> Response {
    return Response.text(value: "ok");
};

fn echoParams(ctx: Context) -> Response {
    var mut parts: List<str> = [];
    for key in ctx.params.keys() {
        parts.append(value: key + "=" + ctx.param(name: key));
    }
    return Response.text(value: ctx.pattern + "|" + parts.join(separator: ","));
};

fn patternOf(ctx: Context) -> Response {
    return Response.text(value: ctx.pattern);
};

fn build(app: App) -> Server {
    var compiled: Result<Server, WebError> = app.compile();
    if compiled.isErr() {
        panic(message: "test app failed to compile: " + compiled.unwrapErr().message);
    }
    return compiled.unwrap();
};

fn call(server: Server, method: HttpMethod, target: str, body: str = "", headers: Map<str, str> = {}) -> Response {
    return server.handle(request: makeRequest(method: method, target: target, body: body, headers: headers));
};

fn get(server: Server, target: str) -> Response {
    return call(server: server, method: HttpMethod::Get, target: target);
};

// Map literals cannot have keys like Access-Control-Request-Method.
fn hdrs(k1: str, v1: str, k2: str = "", v2: str = "", k3: str = "", v3: str = "") -> Map<str, str> {
    var mut out: Map<str, str> = {};
    out.insert(key: k1, value: v1);
    if !k2.isEmpty() { out.insert(key: k2, value: v2); }
    if !k3.isEmpty() { out.insert(key: k3, value: v3); }
    return out;
};
