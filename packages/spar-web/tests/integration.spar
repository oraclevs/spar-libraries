// End-to-end: starts tools/bridge.sh (TCP front end) running examples/api.spar,
// sends real HTTP requests with std/http, then checks the answers with spar-test.
// SPAR has no sync wait on a Promise, so responses are collected in an async
// main first and each Test closes over its observed response.
//
//   spar exec tests/integration.spar
import pkg { Test } from "test/core/test";
import pkg { TestSuite } from "test/core/suite";
import pkg { assertTrue } from "test/assertions/basic";
import pkg { assertEqual, assertEqualStr } from "test/assertions/equality";
import pkg { assertStringContains } from "test/assertions/strings";
import pkg { runMain } from "test/cli/runner";
import pkg { HttpResponse, request } from "std/http";
import pkg { spawn, kill, wait } from "std/process";
import pkg { sleepMillis } from "std/time";
import pkg { println } from "std/io";

const port: int = 18431;

struct Probe {
    name: str = "";
    status: int = 0;
    body: str = "";
    headers: Map<str, str> = {};
};

fn base() -> str {
    return "http://127.0.0.1:" + port.toString();
};

async fn probe(name: str, method: str, path: str, body: str = "", headers: Map<str, str> = {}) -> Probe {
    var res: HttpResponse = await request(method: method, url: base() + path, body: body, headers: headers);
    return Probe(name: name, status: res.status, body: res.body, headers: res.headers);
};

async fn waitUntilUp() -> bool {
    var mut tries: int = 0;
    while tries < 40 {
        try {
            var res: HttpResponse = await request(method: "GET", url: base() + "/");
            return res.status == 200;
        } catch problem {
            sleepMillis(millis: 150);
        }
        tries = tries + 1;
    }
    return false;
};

fn one(name: str, value: str) -> Map<str, str> {
    var mut m: Map<str, str> = {};
    m.insert(key: name, value: value);
    return m;
};

fn two(a: str, b: str, c: str, d: str) -> Map<str, str> {
    var mut m: Map<str, str> = one(name: a, value: b);
    m.insert(key: c, value: d);
    return m;
};

fn header(p: Probe, name: str) -> str {
    return p.headers.getOr(key: name, fallback: "");
};

fn check(p: Probe, status: int, bodyHas: str) -> Test {
    return Test(name: p.name, run: fn() -> void {
        assertEqual(actual: p.status, expected: status);
        assertStringContains(actual: p.body, needle: bodyHas);
    });
};

async fn main() -> int {
    var server = spawn(program: "../tools/bridge.sh", args: ["--port", port.toString(), "../examples/api.spar"]);
    var up: bool = await waitUntilUp();
    if !up {
        kill(process: server);
        println(value: "server did not start");
        return 1;
    }
    var home: Probe = await probe(name: "GET / returns text", method: "GET", path: "/");
    var user: Probe = await probe(name: "GET /api/v1/users/:id returns JSON and the middleware header", method: "GET", path: "/api/v1/users/2");
    var list: Probe = await probe(name: "GET /api/v1/users lists users", method: "GET", path: "/api/v1/users");
    var created: Probe = await probe(name: "POST JSON body is decoded into a struct", method: "POST", path: "/api/v1/users", body: "{\"name\":\"Zed\",\"age\":3}");
    var badJson: Probe = await probe(name: "POST malformed JSON is 400", method: "POST", path: "/api/v1/users", body: "{oops");
    var badType: Probe = await probe(name: "POST wrong field type is 422", method: "POST", path: "/api/v1/users", body: "{\"name\":\"Zed\",\"age\":\"x\"}");
    var query: Probe = await probe(name: "query parameters", method: "GET", path: "/search?q=spar&page=2&tag=a&tag=b");
    var missing: Probe = await probe(name: "unknown path is 404", method: "GET", path: "/nope");
    var unknownUser: Probe = await probe(name: "handler-raised 404 uses the error handler", method: "GET", path: "/api/v1/users/99");
    var wrongMethod: Probe = await probe(name: "wrong method is 405 with Allow", method: "DELETE", path: "/api/v1/users");
    var boom: Probe = await probe(name: "runtime error is a 500 without details", method: "GET", path: "/boom");
    var noAuth: Probe = await probe(name: "group middleware rejects without a token", method: "GET", path: "/api/v1/admin/secret");
    var withAuth: Probe = await probe(name: "group middleware passes data to the handler", method: "GET", path: "/api/v1/admin/secret", headers: one(name: "x-token", value: "letmein"));
    var preflight: Probe = await probe(name: "CORS preflight", method: "OPTIONS", path: "/api/v1/users", headers: two(a: "origin", b: "https://app.example.com", c: "access-control-request-method", d: "POST"));
    var cors: Probe = await probe(name: "CORS simple request", method: "GET", path: "/", headers: one(name: "origin", value: "https://app.example.com"));
    var head: Probe = await probe(name: "HEAD has no body", method: "HEAD", path: "/");
    kill(process: server);
    var suite: TestSuite = TestSuite(name: "spar-web over HTTP", tests: [
        check(p: home, status: 200, bodyHas: "Hello from SPAR"),
        Test(name: user.name, run: fn() -> void {
            assertEqual(actual: user.status, expected: 200);
            assertStringContains(actual: user.body, needle: "\"name\":\"Ada\"");
            assertStringContains(actual: header(p: user, name: "content-type"), needle: "application/json");
            assertEqualStr(actual: header(p: user, name: "x-powered-by"), expected: "spar-web");
        }),
        check(p: list, status: 200, bodyHas: "Obi"),
        check(p: created, status: 201, bodyHas: "\"name\":\"Zed\""),
        check(p: badJson, status: 400, bodyHas: "Invalid JSON body"),
        check(p: badType, status: 422, bodyHas: "expected int"),
        check(p: query, status: 200, bodyHas: "q=spar page=2 tags=2"),
        check(p: missing, status: 404, bodyHas: "not_found"),
        check(p: unknownUser, status: 404, bodyHas: "User 99 not found"),
        Test(name: wrongMethod.name, run: fn() -> void {
            assertEqual(actual: wrongMethod.status, expected: 405);
            assertStringContains(actual: header(p: wrongMethod, name: "allow"), needle: "GET");
        }),
        Test(name: boom.name, run: fn() -> void {
            assertEqual(actual: boom.status, expected: 500);
            assertTrue(actual: !boom.body.contains(needle: "zero"));
        }),
        check(p: noAuth, status: 401, bodyHas: "Unauthorized"),
        check(p: withAuth, status: 200, bodyHas: "secret for admin"),
        Test(name: preflight.name, run: fn() -> void {
            assertEqual(actual: preflight.status, expected: 204);
            assertEqualStr(actual: header(p: preflight, name: "access-control-allow-origin"), expected: "https://app.example.com");
            assertEqualStr(actual: header(p: preflight, name: "access-control-allow-credentials"), expected: "true");
        }),
        Test(name: cors.name, run: fn() -> void {
            assertEqualStr(actual: header(p: cors, name: "access-control-allow-origin"), expected: "https://app.example.com");
        }),
        Test(name: head.name, run: fn() -> void {
            assertEqual(actual: head.status, expected: 200);
            assertEqualStr(actual: head.body, expected: "");
        })
    ]);
    return runMain(suites: [suite]);
};
