// spar-test: the testing library for Spar.
//
// Spar has no re-exports, so import what you need from its own file:
//
//   core/test.spar            Test
//   core/suite.spar           TestSuite
//   core/options.spar         RunOptions
//   core/runner.spar          runSuites                 pure: returns a RunResult
//   assertions/basic.spar     assert, assertTrue, assertFalse, fail
//   assertions/equality.spar  assertEqual, assertEqualStr, ...
//   assertions/comparison.spar assertGreater, assertLess, ...
//   assertions/collections.spar assertContains, assertEmpty, assertLength, ...
//   assertions/strings.spar   assertStringContains, assertStartsWith, assertEndsWith
//   result/*.spar             Failure, Value, TestResult, SuiteResult, RunResult
//   reporter/reporter.spar    Reporter                  the reporter boundary
//   reporter/console.spar     consoleReporter
//   cli/runner.spar           runMain                   CLI entry: returns exit status
