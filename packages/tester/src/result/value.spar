// A typed snapshot of an asserted value. Spar has no unions and generic code
// cannot compare with `==`, so each kind keeps its payload in its own field.
// Reporters turn these into text; assertions never format anything.
export enum AssertedKind {
    Unset,
    Int,
    Float,
    Bool,
    Str,
    IntList,
    FloatList,
    BoolList,
    StrList
};

export struct Value {
    kind: AssertedKind = AssertedKind::Unset;
    intVal: int = 0;
    floatVal: float = 0.0;
    boolVal: bool = false;
    strVal: str = "";
    ints: List<int> = [];
    floats: List<float> = [];
    bools: List<bool> = [];
    strs: List<str> = [];
};

fn unsetValue() -> Value {
    return Value();
};

fn intValue(value: int) -> Value {
    return Value(kind: AssertedKind::Int, intVal: value);
};

fn floatValue(value: float) -> Value {
    return Value(kind: AssertedKind::Float, floatVal: value);
};

fn boolValue(value: bool) -> Value {
    return Value(kind: AssertedKind::Bool, boolVal: value);
};

fn strValue(value: str) -> Value {
    return Value(kind: AssertedKind::Str, strVal: value);
};

fn intListValue(value: List<int>) -> Value {
    return Value(kind: AssertedKind::IntList, ints: value);
};

fn floatListValue(value: List<float>) -> Value {
    return Value(kind: AssertedKind::FloatList, floats: value);
};

fn boolListValue(value: List<bool>) -> Value {
    return Value(kind: AssertedKind::BoolList, bools: value);
};

fn strListValue(value: List<str>) -> Value {
    return Value(kind: AssertedKind::StrList, strs: value);
};
