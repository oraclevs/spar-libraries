import { Failure } from "./failure.spar";
import { TestResult, TestStatus } from "./test_result.spar";

export struct SuiteResult {
    name: str;
    testResults: List<TestResult> = [];
    // Failures of beforeAll / afterAll hooks (not tied to one test).
    hookFailures: List<Failure> = [];
    passed: int = 0;
    failed: int = 0;
    skipped: int = 0;
    duration: int = 0;
};

// Appends a test result and keeps the counters in step.
fn addTestResult(suite: SuiteResult, result: TestResult) -> SuiteResult {
    var mut next: SuiteResult = suite;
    next.testResults.append(value: result);
    if result.status == TestStatus::Passed {
        next.passed = next.passed + 1;
    } else if result.status == TestStatus::Failed {
        next.failed = next.failed + 1;
    } else {
        next.skipped = next.skipped + 1;
    }
    return next;
};
