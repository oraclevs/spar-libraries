import { Value, unsetValue } from "./value.spar";

// What one failed assertion reports. Pure data; reporters decide how to show it.
// `testName` is filled in by the runner. Spar exposes no file/line information,
// so there is no source location yet.
export struct Failure {
    assertion: str;
    message: str = "";
    expected: Value = unsetValue();
    actual: Value = unsetValue();
    testName: str = "";
};
