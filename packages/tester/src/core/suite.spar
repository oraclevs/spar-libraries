import { Test, noop } from "./test.spar";

// A named group of tests with optional lifecycle hooks.
// Hooks default to a function that does nothing.
export struct TestSuite {
    name: str;
    tests: List<Test> = [];
    beforeAll: fn() -> void = noop;
    afterAll: fn() -> void = noop;
    beforeEach: fn() -> void = noop;
    afterEach: fn() -> void = noop;
};
