import { Test } from "./test.spar";
import { TestSuite } from "./suite.spar";

// Case-insensitive substring match. An empty filter matches everything.
fn matchesText(text: str, filter: str) -> bool {
    if filter.length() == 0 {
        return true;
    }
    return text.lower().contains(needle: filter.lower());
};

// A test is selected when the filter matches its suite name or its own name.
fn testSelected(suite: TestSuite, test: Test, filter: str) -> bool {
    return matchesText(text: suite.name, filter: filter) || matchesText(text: test.name, filter: filter);
};

// The suite reduced to the selected tests (hooks and name unchanged).
fn selectTests(suite: TestSuite, filter: str) -> TestSuite {
    var mut picked: List<Test> = [];
    for test in suite.tests {
        if testSelected(suite: suite, test: test, filter: filter) {
            picked.append(value: test);
        }
    }
    var mut next: TestSuite = suite;
    next.tests = picked;
    return next;
};

// Suites that still have at least one test after filtering.
fn selectSuites(suites: List<TestSuite>, filter: str) -> List<TestSuite> {
    var mut out: List<TestSuite> = [];
    for suite in suites {
        var picked: TestSuite = selectTests(suite: suite, filter: filter);
        if picked.tests.length() > 0 {
            out.append(value: picked);
        }
    }
    return out;
};
