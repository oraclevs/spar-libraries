import { runMain } from "../src/cli/runner.spar";
import { assertionsSuite } from "./assertions.spar";
import { runnerSuite } from "./runner.spar";
import { reportingSuite } from "./reporting.spar";

// The library's own test suite. Accepts every spar-test option:
//   spar tests/all.spar --filter runner --verbose
fn main() -> int {
    return runMain(suites: [assertionsSuite(), runnerSuite(), reportingSuite()]);
};
