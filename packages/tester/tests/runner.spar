import { Test } from "../src/core/test.spar";
import { TestSuite } from "../src/core/suite.spar";
import { RunOptions } from "../src/core/options.spar";
import { RunResult, isSuccess } from "../src/result/run_result.spar";
import { SuiteResult } from "../src/result/suite_result.spar";
import { TestResult, TestStatus } from "../src/result/test_result.spar";
import { assertTrue, assertFalse } from "../src/assertions/basic.spar";
import { assertEqual, assertEqualStr, assertEqualStrs } from "../src/assertions/equality.spar";
import { runMain } from "../src/cli/runner.spar";
import { run } from "./support.spar";

// Hooks and tests record what happened in `log`. Module state is private to
// this module, and all of these functions live here, so they share it.
var mut log: List<str> = [];

fn note(entry: str) -> void { log.append(value: entry); };
fn good() -> void { assertEqual(actual: 1, expected: 1); };
fn bad() -> void { assertEqual(actual: 1, expected: 2); };
fn testOne() -> void { note(entry: "test1"); };
fn testTwo() -> void { note(entry: "test2"); };
fn hookBeforeAll() -> void { note(entry: "beforeAll"); };
fn hookAfterAll() -> void { note(entry: "afterAll"); };
fn hookBeforeEach() -> void { note(entry: "beforeEach"); };
fn hookAfterEach() -> void { note(entry: "afterEach"); };
fn failingBeforeEach() -> void { assertTrue(actual: false, message: "setup broke"); };
fn failingBeforeAll() -> void { assertTrue(actual: false, message: "suite setup broke"); };
fn failingAfterEach() -> void { assertTrue(actual: false, message: "teardown broke"); };
fn failingAfterAll() -> void { assertTrue(actual: false, message: "suite teardown broke"); };

fn mixedSuite() -> TestSuite {
    return TestSuite(name: "Mixed", tests: [
        Test(name: "passes", run: good),
        Test(name: "fails", run: bad),
        Test(name: "ignored", run: bad, enabled: false),
        Test(name: "passes again", run: good)
    ]);
};

fn countsAreAggregated() -> void {
    var result: RunResult = run(suites: [mixedSuite()], options: RunOptions());
    assertEqual(actual: result.total, expected: 4);
    assertEqual(actual: result.passed, expected: 2);
    assertEqual(actual: result.failed, expected: 1);
    assertEqual(actual: result.skipped, expected: 1);
    assertFalse(actual: isSuccess(run: result));
    var suite: SuiteResult = result.suites.get(index: 0).unwrap();
    assertEqualStr(actual: suite.name, expected: "Mixed");
    assertEqual(actual: suite.testResults.length(), expected: 4);
    assertEqual(actual: suite.passed, expected: 2);
};

fn skippedTestsDoNotRun() -> void {
    var result: RunResult = run(suites: [mixedSuite()], options: RunOptions());
    var skipped: TestResult = result.suites.get(index: 0).unwrap().testResults.get(index: 2).unwrap();
    assertTrue(actual: skipped.status == TestStatus::Skipped);
    assertEqual(actual: skipped.failures.length(), expected: 0);
};

fn multipleSuitesAggregate() -> void {
    var other: TestSuite = TestSuite(name: "Other", tests: [Test(name: "fine", run: good)]);
    var result: RunResult = run(suites: [mixedSuite(), other], options: RunOptions());
    assertEqual(actual: result.suites.length(), expected: 2);
    assertEqual(actual: result.total, expected: 5);
    assertEqual(actual: result.passed, expected: 3);
};

fn allPassingRunSucceeds() -> void {
    var suite: TestSuite = TestSuite(name: "Ok", tests: [Test(name: "a", run: good)]);
    assertTrue(actual: isSuccess(run: run(suites: [suite], options: RunOptions())));
};

fn failureCarriesTestName() -> void {
    var result: RunResult = run(suites: [mixedSuite()], options: RunOptions());
    var failed: TestResult = result.suites.get(index: 0).unwrap().testResults.get(index: 1).unwrap();
    assertEqual(actual: failed.failures.length(), expected: 1);
    assertEqualStr(actual: failed.failures.get(index: 0).unwrap().testName, expected: "fails");
};

fn hooksRunInOrder() -> void {
    log = [];
    var suite: TestSuite = TestSuite(
        name: "Hooks",
        tests: [Test(name: "one", run: testOne), Test(name: "two", run: testTwo)],
        beforeAll: hookBeforeAll,
        afterAll: hookAfterAll,
        beforeEach: hookBeforeEach,
        afterEach: hookAfterEach,
    );
    run(suites: [suite], options: RunOptions());
    assertEqualStrs(actual: log, expected: [
        "beforeAll",
        "beforeEach", "test1", "afterEach",
        "beforeEach", "test2", "afterEach",
        "afterAll"
    ]);
};

fn failingBeforeEachFailsTestAndSkipsBody() -> void {
    log = [];
    var suite: TestSuite = TestSuite(
        name: "Broken setup",
        tests: [Test(name: "one", run: testOne)],
        beforeEach: failingBeforeEach,
        afterEach: hookAfterEach,
    );
    var result: RunResult = run(suites: [suite], options: RunOptions());
    assertEqual(actual: result.failed, expected: 1);
    assertEqualStrs(actual: log, expected: ["afterEach"]);
};

fn failingAfterEachFailsTest() -> void {
    var suite: TestSuite = TestSuite(name: "Broken teardown", tests: [Test(name: "one", run: good)], afterEach: failingAfterEach);
    var result: RunResult = run(suites: [suite], options: RunOptions());
    assertEqual(actual: result.failed, expected: 1);
};

fn failingBeforeAllSkipsSuiteButRunContinues() -> void {
    log = [];
    var broken: TestSuite = TestSuite(
        name: "Broken suite",
        tests: [Test(name: "one", run: testOne)],
        beforeAll: failingBeforeAll,
        afterAll: hookAfterAll,
    );
    var fine: TestSuite = TestSuite(name: "Fine", tests: [Test(name: "two", run: testTwo)]);
    var result: RunResult = run(suites: [broken, fine], options: RunOptions());
    assertEqual(actual: result.skipped, expected: 1);
    assertEqual(actual: result.passed, expected: 1);
    assertEqual(actual: result.hookFailures, expected: 1);
    assertFalse(actual: isSuccess(run: result));
    assertEqualStrs(actual: log, expected: ["afterAll", "test2"]);
};

fn failingAfterAllIsReported() -> void {
    var suite: TestSuite = TestSuite(name: "S", tests: [Test(name: "one", run: good)], afterAll: failingAfterAll);
    var result: RunResult = run(suites: [suite], options: RunOptions());
    assertEqual(actual: result.passed, expected: 1);
    assertEqual(actual: result.hookFailures, expected: 1);
    assertFalse(actual: isSuccess(run: result));
};

fn filterMatchesTestNames() -> void {
    var result: RunResult = run(suites: [mixedSuite()], options: RunOptions(filter: "again"));
    assertEqual(actual: result.total, expected: 1);
};

fn filterMatchesSuiteNamesCaseInsensitively() -> void {
    var other: TestSuite = TestSuite(name: "Parser", tests: [Test(name: "a", run: good), Test(name: "b", run: good)]);
    var result: RunResult = run(suites: [mixedSuite(), other], options: RunOptions(filter: "PARSER"));
    assertEqual(actual: result.suites.length(), expected: 1);
    assertEqual(actual: result.total, expected: 2);
};

fn filterWithNoMatchRunsNothing() -> void {
    var result: RunResult = run(suites: [mixedSuite()], options: RunOptions(filter: "zzz"));
    assertEqual(actual: result.total, expected: 0);
    assertTrue(actual: isSuccess(run: result));
};

fn failFastStopsAfterFirstFailure() -> void {
    var result: RunResult = run(suites: [mixedSuite(), mixedSuite()], options: RunOptions(failFast: true));
    assertEqual(actual: result.failed, expected: 1);
    assertEqual(actual: result.total, expected: 2);
    assertEqual(actual: result.suites.length(), expected: 1);
};

fn withoutFailFastEverythingRuns() -> void {
    var result: RunResult = run(suites: [mixedSuite(), mixedSuite()], options: RunOptions());
    assertEqual(actual: result.failed, expected: 2);
    assertEqual(actual: result.total, expected: 8);
};

fn listModeRunsNothing() -> void {
    log = [];
    var suite: TestSuite = TestSuite(name: "S", tests: [Test(name: "one", run: testOne)]);
    var result: RunResult = run(suites: [suite], options: RunOptions(list: true));
    assertEqual(actual: result.total, expected: 0);
    assertEqual(actual: log.length(), expected: 0);
};

fn durationsAreRecorded() -> void {
    var result: RunResult = run(suites: [mixedSuite()], options: RunOptions());
    assertTrue(actual: result.duration >= 0);
    assertTrue(actual: result.suites.get(index: 0).unwrap().duration >= 0);
};

fn runnerSuite() -> TestSuite {
    return TestSuite(name: "Runner", tests: [
        Test(name: "counts are aggregated", run: countsAreAggregated),
        Test(name: "skipped tests do not run", run: skippedTestsDoNotRun),
        Test(name: "multiple suites aggregate", run: multipleSuitesAggregate),
        Test(name: "all-passing run succeeds", run: allPassingRunSucceeds),
        Test(name: "failures carry the test name", run: failureCarriesTestName),
        Test(name: "hooks run in order", run: hooksRunInOrder),
        Test(name: "failing beforeEach fails the test and skips its body", run: failingBeforeEachFailsTestAndSkipsBody),
        Test(name: "failing afterEach fails the test", run: failingAfterEachFailsTest),
        Test(name: "failing beforeAll skips the suite but the run continues", run: failingBeforeAllSkipsSuiteButRunContinues),
        Test(name: "failing afterAll is reported", run: failingAfterAllIsReported),
        Test(name: "filter matches test names", run: filterMatchesTestNames),
        Test(name: "filter matches suite names case-insensitively", run: filterMatchesSuiteNamesCaseInsensitively),
        Test(name: "filter with no match runs nothing", run: filterWithNoMatchRunsNothing),
        Test(name: "fail-fast stops after the first failure", run: failFastStopsAfterFirstFailure),
        Test(name: "without fail-fast everything runs", run: withoutFailFastEverythingRuns),
        Test(name: "list mode runs nothing", run: listModeRunsNothing),
        Test(name: "durations are recorded", run: durationsAreRecorded)
    ]);
};

fn main() -> int {
    return runMain(suites: [runnerSuite()]);
};
