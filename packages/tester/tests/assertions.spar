import { Test } from "../src/core/test.spar";
import { TestSuite } from "../src/core/suite.spar";
import { Failure } from "../src/result/failure.spar";
import { AssertedKind } from "../src/result/value.spar";
import { assertThat, assertTrue, assertFalse, fail } from "../src/assertions/basic.spar";
import {
    assertEqual, assertNotEqual, assertEqualStr, assertNotEqualStr, assertEqualBool,
    assertEqualFloat, assertEqualInts, assertEqualStrs, assertEqualFloats, assertEqualBools
} from "../src/assertions/equality.spar";
import {
    assertGreater, assertGreaterOrEqual, assertLess, assertLessOrEqual,
    assertGreaterFloat, assertLessFloat
} from "../src/assertions/comparison.spar";
import {
    assertContains, assertNotContains, assertContainsStr, assertEmpty, assertNotEmpty, assertLength
} from "../src/assertions/collections.spar";
import { assertStringContains, assertStartsWith, assertEndsWith } from "../src/assertions/strings.spar";
import { assertFails } from "../src/assertions/errors.spar";
import { runMain } from "../src/cli/runner.spar";
import { passes, fails, failureOf } from "./support.spar";

// Each fixture below is a plain test body; the tests run it under the real
// runner and check whether it passed or what Failure it produced.
fn okTrue() -> void { assertTrue(actual: 1 < 2); };
fn badTrue() -> void { assertTrue(actual: 2 < 1, message: "math broke"); };
fn okFalse() -> void { assertFalse(actual: 2 < 1); };
fn badFalse() -> void { assertFalse(actual: true); };
fn okThat() -> void { assertThat(condition: true); };
fn badThat() -> void { assertThat(condition: false); };
fn explicitFail() -> void { fail(message: "nope"); };
fn okEqual() -> void { assertEqual(actual: 2 + 2, expected: 4); };
fn badEqual() -> void { assertEqual(actual: 1, expected: 2); };
fn okNotEqual() -> void { assertNotEqual(actual: 1, expected: 2); };
fn badNotEqual() -> void { assertNotEqual(actual: 3, expected: 3); };
fn okStr() -> void { assertEqualStr(actual: "a" + "b", expected: "ab"); };
fn badStr() -> void { assertEqualStr(actual: "hello", expected: "world"); };
fn badNotStr() -> void { assertNotEqualStr(actual: "x", expected: "x"); };
fn okBool() -> void { assertEqualBool(actual: true, expected: true); };
fn okFloat() -> void { assertEqualFloat(actual: 0.1 + 0.2, expected: 0.3, tolerance: 0.0001); };
fn badFloat() -> void { assertEqualFloat(actual: 1.5, expected: 2.5); };
fn okInts() -> void { assertEqualInts(actual: [1, 2, 3], expected: [1, 2, 3]); };
fn badInts() -> void { assertEqualInts(actual: [1, 2], expected: [1, 3]); };
fn badIntsLength() -> void { assertEqualInts(actual: [1], expected: [1, 2]); };
fn okStrs() -> void { assertEqualStrs(actual: ["a", "b"], expected: ["a", "b"]); };
fn badStrs() -> void { assertEqualStrs(actual: ["a"], expected: ["b"]); };
fn okFloats() -> void { assertEqualFloats(actual: [1.5], expected: [1.5]); };
fn okBools() -> void { assertEqualBools(actual: [true, false], expected: [true, false]); };
fn okCompare() -> void {
    assertGreater(actual: 3, bound: 2);
    assertGreaterOrEqual(actual: 3, bound: 3);
    assertLess(actual: 1, bound: 2);
    assertLessOrEqual(actual: 2, bound: 2);
    assertGreaterFloat(actual: 2.5, bound: 1.5);
    assertLessFloat(actual: 1.5, bound: 2.5);
};
fn badGreater() -> void { assertGreater(actual: 2, bound: 2); };
fn badGreaterEq() -> void { assertGreaterOrEqual(actual: 1, bound: 2); };
fn badLess() -> void { assertLess(actual: 2, bound: 2); };
fn badLessEq() -> void { assertLessOrEqual(actual: 3, bound: 2); };
fn okContains() -> void {
    assertContains(items: [1, 2, 3], item: 2);
    assertNotContains(items: [1, 2, 3], item: 9);
    assertContainsStr(items: ["a", "b"], item: "b");
};
fn badContains() -> void { assertContains(items: [1, 2, 3], item: 9); };
fn badNotContains() -> void { assertNotContains(items: [1, 2, 3], item: 2); };
fn okEmpty() -> void {
    var none: List<int> = [];
    assertEmpty(items: none);
    assertNotEmpty(items: [1]);
};
fn badEmpty() -> void { assertEmpty(items: [1]); };
fn badNotEmpty() -> void {
    var none: List<int> = [];
    assertNotEmpty(items: none);
};
fn okLength() -> void {
    assertLength(items: [1, 2, 3], expected: 3);
    assertLength(items: ["a"], expected: 1);
};
fn badLength() -> void { assertLength(items: [1, 2], expected: 5); };
fn okStrings() -> void {
    assertStringContains(actual: "hello world", needle: "lo wo");
    assertStartsWith(actual: "hello", prefix: "he");
    assertEndsWith(actual: "hello", suffix: "llo");
};
fn badContainsText() -> void { assertStringContains(actual: "hello", needle: "xyz"); };
fn badStarts() -> void { assertStartsWith(actual: "hello", prefix: "lo"); };
fn badEnds() -> void { assertEndsWith(actual: "hello", suffix: "he"); };
fn unexpectedError() -> void {
    var zero: int = 0;
    var boom: int = 1 / zero;
};

fn divides() -> void {
    var zero: int = 0;
    var boom: int = 1 / zero;
};
fn quiet() -> void { var fine: int = 1; };
fn okFails() -> void { assertFails(body: divides); };
fn badFails() -> void { assertFails(body: quiet); };

fn assertFailsChecksForErrors() -> void {
    assertTrue(actual: passes(body: okFails));
    assertTrue(actual: fails(body: badFails));
    assertEqualStr(actual: failureOf(body: badFails).assertion, expected: "assertFails");
};

fn passTest() -> void { assertTrue(actual: passes(body: okTrue)); };

fn failingAssertionsFail() -> void {
    assertTrue(actual: fails(body: badTrue));
    assertTrue(actual: fails(body: badFalse));
    assertTrue(actual: fails(body: badThat));
    assertTrue(actual: fails(body: explicitFail));
    assertTrue(actual: fails(body: badEqual));
    assertTrue(actual: fails(body: badNotEqual));
    assertTrue(actual: fails(body: badStr));
    assertTrue(actual: fails(body: badNotStr));
    assertTrue(actual: fails(body: badFloat));
    assertTrue(actual: fails(body: badInts));
    assertTrue(actual: fails(body: badIntsLength));
    assertTrue(actual: fails(body: badStrs));
};

fn passingAssertionsPass() -> void {
    assertTrue(actual: passes(body: okFalse));
    assertTrue(actual: passes(body: okThat));
    assertTrue(actual: passes(body: okEqual));
    assertTrue(actual: passes(body: okNotEqual));
    assertTrue(actual: passes(body: okStr));
    assertTrue(actual: passes(body: okBool));
    assertTrue(actual: passes(body: okFloat));
    assertTrue(actual: passes(body: okInts));
    assertTrue(actual: passes(body: okStrs));
    assertTrue(actual: passes(body: okFloats));
    assertTrue(actual: passes(body: okBools));
};

fn comparisons() -> void {
    assertTrue(actual: passes(body: okCompare));
    assertTrue(actual: fails(body: badGreater));
    assertTrue(actual: fails(body: badGreaterEq));
    assertTrue(actual: fails(body: badLess));
    assertTrue(actual: fails(body: badLessEq));
};

fn collections() -> void {
    assertTrue(actual: passes(body: okContains));
    assertTrue(actual: passes(body: okEmpty));
    assertTrue(actual: passes(body: okLength));
    assertTrue(actual: fails(body: badContains));
    assertTrue(actual: fails(body: badNotContains));
    assertTrue(actual: fails(body: badEmpty));
    assertTrue(actual: fails(body: badNotEmpty));
    assertTrue(actual: fails(body: badLength));
};

fn strings() -> void {
    assertTrue(actual: passes(body: okStrings));
    assertTrue(actual: fails(body: badContainsText));
    assertTrue(actual: fails(body: badStarts));
    assertTrue(actual: fails(body: badEnds));
};

fn failureIsStructured() -> void {
    var failure: Failure = failureOf(body: badEqual);
    assertEqualStr(actual: failure.assertion, expected: "assertEqual");
    assertEqualStr(actual: failure.testName, expected: "fixture test");
    assertTrue(actual: failure.expected.kind == AssertedKind::Int);
    assertEqual(actual: failure.expected.intVal, expected: 2);
    assertEqual(actual: failure.actual.intVal, expected: 1);
    var withMessage: Failure = failureOf(body: badTrue);
    assertEqualStr(actual: withMessage.message, expected: "math broke");
};

fn failureKeepsTypedValues() -> void {
    var text: Failure = failureOf(body: badStr);
    assertTrue(actual: text.actual.kind == AssertedKind::Str);
    assertEqualStr(actual: text.actual.strVal, expected: "hello");
    var ints: Failure = failureOf(body: badInts);
    assertTrue(actual: ints.actual.kind == AssertedKind::IntList);
    assertEqualInts(actual: ints.actual.ints, expected: [1, 2]);
    assertEqualInts(actual: ints.expected.ints, expected: [1, 3]);
    var strs: Failure = failureOf(body: badStrs);
    assertEqualStrs(actual: strs.expected.strs, expected: ["b"]);
    var decimal: Failure = failureOf(body: badFloat);
    assertEqualFloat(actual: decimal.actual.floatVal, expected: 1.5);
};

fn unexpectedErrorsAreFailures() -> void {
    var failure: Failure = failureOf(body: unexpectedError);
    assertEqualStr(actual: failure.assertion, expected: "error");
};

fn assertionsSuite() -> TestSuite {
    return TestSuite(name: "Assertions", tests: [
        Test(name: "a passing assertion passes", run: passTest),
        Test(name: "failing assertions fail", run: failingAssertionsFail),
        Test(name: "passing assertions pass", run: passingAssertionsPass),
        Test(name: "numeric comparisons", run: comparisons),
        Test(name: "collection assertions", run: collections),
        Test(name: "string assertions", run: strings),
        Test(name: "failures are structured", run: failureIsStructured),
        Test(name: "failures keep typed values", run: failureKeepsTypedValues),
        Test(name: "unexpected runtime errors become failures", run: unexpectedErrorsAreFailures),
        Test(name: "assertFails detects recoverable errors", run: assertFailsChecksForErrors)
    ]);
};

fn main() -> int {
    return runMain(suites: [assertionsSuite()]);
};
