import { Cli } from "../src/config/cli.spar";
import { Positional } from "../src/config/positional.spar";
import { ArgOption } from "../src/config/option.spar";
import { Flag } from "../src/config/flag.spar";
import { Choice } from "../src/config/choice.spar";
import {
    ValueSpec,
    ValueKind,
    ValueCollection
} from "../src/config/value_spec.spar";
import { CliSettings } from "../src/config/settings.spar";
import { Matches } from "../src/result/matches.spar";
import { ParseErrorKind } from "../src/result/parse_error.spar";
import {
    check,
    checkEq,
    report,
    good,
    succeeds,
    failsWith
} from "./support.spar";

fn basics() -> int {
    var mut failed: int = 0;
    var cli: Cli = Cli(
        name: "t",
        positionals: [
            Positional(name: "source", required: true),
            Positional(name: "dest", required: true),
            Positional(
                name: "mode",
                defaultValues: ["copy"],
                choices: [Choice(value: "copy"), Choice(value: "move")],
            )
        ],
    );
    var all: Matches = good(cli: cli, argv: ["a", "b", "move"]);
    failed = failed + check(
        label: "positionals fill in order",
        condition: all.getStr(name: "source").unwrap() == "a"
            && all.getStr(name: "dest").unwrap() == "b"
            && all.getStr(name: "mode").unwrap() == "move",
    );
    var short: Matches = good(cli: cli, argv: ["a", "b"]);
    failed = failed + checkEq(
        label: "optional positional takes its default",
        actual: short.getStr(name: "mode").unwrap(),
        expected: "copy",
    );
    failed = failed + check(
        label: "default is not 'given'",
        condition: !short.given(name: "mode") && short.given(name: "dest"),
    );
    failed = failed + check(
        label: "missing required positional",
        condition: failsWith(
            cli: cli,
            argv: ["a"],
            kind: ParseErrorKind::MissingRequired,
        ),
    );
    failed = failed + check(
        label: "nothing at all",
        condition: failsWith(
            cli: cli,
            argv: [],
            kind: ParseErrorKind::MissingRequired,
        ),
    );
    failed = failed + check(
        label: "too many positionals",
        condition: failsWith(
            cli: cli,
            argv: ["a", "b", "copy", "extra"],
            kind: ParseErrorKind::UnexpectedPositional,
        ),
    );
    failed = failed + check(
        label: "positional choice is checked",
        condition: failsWith(
            cli: cli,
            argv: ["a", "b", "delete"],
            kind: ParseErrorKind::InvalidChoice,
        ),
    );
    return failed;
};

fn variadic() -> int {
    var mut failed: int = 0;
    var cli: Cli = Cli(
        name: "t",
        positionals: [
            Positional(name: "command", required: true),
            Positional(name: "rest", trailing: true)
        ],
    );
    var m: Matches = good(cli: cli, argv: ["run", "x", "y", "z"]);
    failed = failed + check(
        label: "trailing takes the remainder",
        condition: m.getList(name: "rest").join(separator: ",") == "x,y,z",
    );
    failed = failed + checkEq(
        label: "first stays first",
        actual: m.getStr(name: "command").unwrap(),
        expected: "run",
    );
    var alone: Matches = good(cli: cli, argv: ["run"]);
    failed = failed + check(
        label: "trailing may be empty",
        condition: alone.getList(name: "rest").length() == 0
            && !alone.has(name: "rest"),
    );
    var reserved: Cli = Cli(
        name: "t",
        positionals: [
            Positional(
                name: "files",
                required: true,
                value: ValueSpec(
                    maxValues: 0,
                    collection: ValueCollection::List,
                ),
            ),
            Positional(name: "target", required: true)
        ],
    );
    var copy: Matches = good(cli: reserved, argv: ["a", "b", "c", "dir"]);
    failed = failed + check(
        label: "greedy positional leaves one for the last",
        condition: copy.getList(name: "files").length() == 3
            && copy.getStr(name: "target").unwrap() == "dir",
    );
    failed = failed + check(
        label: "greedy positional needs the last one too",
        condition: failsWith(
            cli: reserved,
            argv: [],
            kind: ParseErrorKind::MissingRequired,
        ),
    );
    var typed: Cli = Cli(
        name: "t",
        positionals: [
            Positional(name: "n", value: ValueSpec(kind: ValueKind::Int))
        ],
    );
    failed = failed + check(
        label: "typed positional",
        condition: good(cli: typed, argv: ["42"]).getInt(name: "n").unwrap() == 42,
    );
    failed = failed + check(
        label: "negative number is a positional",
        condition: good(cli: typed, argv: ["-7"]).getInt(name: "n").unwrap() == -7,
    );
    failed = failed + check(
        label: "bad typed positional",
        condition: failsWith(
            cli: typed,
            argv: ["x"],
            kind: ParseErrorKind::InvalidValue,
        ),
    );
    return failed;
};

fn separators() -> int {
    var mut failed: int = 0;
    var cli: Cli = Cli(
        name: "t",
        flags: [Flag(name: "all", short: "a", long: "all")],
        positionals: [Positional(name: "words", trailing: true)],
    );
    var m: Matches = good(
        cli: cli,
        argv: ["-a", "x", "--", "--all", "-a", "y"],
    );
    failed = failed + check(
        label: "after -- everything is a positional",
        condition: m.getList(name: "words").join(separator: ",") == "x,--all,-a,y",
    );
    failed = failed + check(
        label: "the flag before -- still applies",
        condition: m.flag(name: "all"),
    );
    var interleaved: Matches = good(cli: cli, argv: ["x", "-a", "y"]);
    failed = failed + check(
        label: "flags may sit between positionals",
        condition: interleaved.flag(name: "all")
            && interleaved.getList(name: "words").length() == 2,
    );
    var lax: Cli = Cli(
        name: "t",
        flags: cli.flags,
        positionals: cli.positionals,
        settings: CliSettings(stopAtDoubleDash: false),
    );
    failed = failed + check(
        label: "-- ignored when stopAtDoubleDash is off",
        condition: good(cli: lax, argv: ["--", "-a"]).flag(name: "all"),
    );
    var dash: Matches = good(cli: cli, argv: ["-"]);
    failed = failed + check(
        label: "a lone dash is a positional",
        condition: dash.getStr(name: "words").unwrap() == "-",
    );
    return failed;
};

fn main() -> int {
    var mut bad: int = 0;
    bad = bad + report(suite: "positionals", failures: basics());
    bad = bad + report(suite: "variadic positionals", failures: variadic());
    bad = bad + report(suite: "separators", failures: separators());
    return bad;
};
