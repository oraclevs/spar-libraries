import { Cli } from "../src/config/cli.spar";
import { ArgOption } from "../src/config/option.spar";
import { Flag, FlagAction } from "../src/config/flag.spar";
import { Choice } from "../src/config/choice.spar";
import {
    ValueSpec,
    ValueKind,
    ValueCollection
} from "../src/config/value_spec.spar";
import { CliSettings } from "../src/config/settings.spar";
import { Matches } from "../src/result/matches.spar";
import { ParseErrorKind } from "../src/result/parse_error.spar";
import {
    check,
    checkEq,
    report,
    good,
    succeeds,
    failsWith
} from "./support.spar";

fn flagCli() -> Cli {
    return Cli(
        name: "t",
        flags: [
            Flag(
                name: "verbose",
                short: "v",
                long: "verbose",
                action: FlagAction::Count,
            ),
            Flag(name: "all", short: "a", long: "all"),
            Flag(name: "force", short: "f", long: "force"),
            Flag(
                name: "color",
                long: "no-color",
                action: FlagAction::SetFalse,
            )
        ],
    );
};

fn flags() -> int {
    var mut failed: int = 0;
    var cli: Cli = flagCli();
    var none: Matches = good(cli: cli, argv: []);
    failed = failed + check(
        label: "absent SetTrue flag is false",
        condition: !none.flag(name: "all"),
    );
    failed = failed + check(
        label: "absent SetFalse flag is true",
        condition: none.flag(name: "color"),
    );
    failed = failed + check(
        label: "absent Count flag is 0",
        condition: none.count(name: "verbose") == 0,
    );
    failed = failed + check(
        label: "absent flag is not given",
        condition: !none.given(name: "all"),
    );
    var one: Matches = good(cli: cli, argv: ["--all", "--no-color"]);
    failed = failed + check(
        label: "--all sets the flag",
        condition: one.flag(name: "all"),
    );
    failed = failed + check(
        label: "--no-color clears it",
        condition: !one.flag(name: "color"),
    );
    failed = failed + check(
        label: "given reports typed flags",
        condition: one.given(name: "all"),
    );
    var counted: Matches = good(cli: cli, argv: ["-vvv"]);
    failed = failed + check(
        label: "-vvv counts three",
        condition: counted.count(name: "verbose") == 3,
    );
    failed = failed + check(
        label: "Count flag reads as an int",
        condition: counted.getInt(name: "verbose").unwrap() == 3,
    );
    var mixed: Matches = good(cli: cli, argv: ["-v", "--verbose", "-v"]);
    failed = failed + check(
        label: "mixed spellings add up",
        condition: mixed.count(name: "verbose") == 3,
    );
    var cluster: Matches = good(cli: cli, argv: ["-avf"]);
    failed = failed + check(
        label: "cluster sets every flag",
        condition: cluster.flag(name: "all")
            && cluster.flag(name: "force")
            && cluster.count(name: "verbose") == 1,
    );
    failed = failed + check(
        label: "flag with a value is rejected",
        condition: failsWith(
            cli: cli,
            argv: ["--all=yes"],
            kind: ParseErrorKind::UnexpectedValue,
        ),
    );
    failed = failed + check(
        label: "unknown long flag",
        condition: failsWith(
            cli: cli,
            argv: ["--nope"],
            kind: ParseErrorKind::UnknownArgument,
        ),
    );
    failed = failed + check(
        label: "unknown short flag",
        condition: failsWith(
            cli: cli,
            argv: ["-z"],
            kind: ParseErrorKind::UnknownArgument,
        ),
    );
    var settings: CliSettings = CliSettings(allowCombinedShortFlags: false);
    var strict: Cli = Cli(name: "t", flags: cli.flags, settings: settings);
    failed = failed + check(
        label: "clusters can be switched off",
        condition: failsWith(
            cli: strict,
            argv: ["-av"],
            kind: ParseErrorKind::UnknownArgument,
        ),
    );
    failed = failed + check(
        label: "single flags still work then",
        condition: succeeds(cli: strict, argv: ["-a"]),
    );
    return failed;
};

fn optionCli() -> Cli {
    return Cli(
        name: "t",
        flags: [Flag(name: "all", short: "a", long: "all")],
        options: [
            ArgOption(
                name: "output",
                short: "o",
                long: "output",
                aliases: ["out"],
            ),
            ArgOption(
                name: "level",
                long: "level",
                defaultValues: ["3"],
                value: ValueSpec(kind: ValueKind::Int),
            ),
            ArgOption(
                name: "ratio",
                long: "ratio",
                value: ValueSpec(kind: ValueKind::Float),
            ),
            ArgOption(
                name: "enabled",
                long: "enabled",
                value: ValueSpec(kind: ValueKind::Bool),
            ),
            ArgOption(name: "tag", short: "t", long: "tag", repeatable: true),
            ArgOption(
                name: "tags",
                long: "tags",
                value: ValueSpec(
                    collection: ValueCollection::List,
                    delimiter: ",",
                ),
            ),
            ArgOption(
                name: "point",
                long: "point",
                value: ValueSpec(
                    kind: ValueKind::Int,
                    collection: ValueCollection::List,
                    minValues: 2,
                    maxValues: 2,
                ),
            ),
            ArgOption(
                name: "offset",
                long: "offset",
                value: ValueSpec(kind: ValueKind::Int),
            ),
            ArgOption(
                name: "pattern",
                long: "pattern",
                value: ValueSpec(allowHyphenValue: true),
            )
        ],
    );
};

fn options() -> int {
    var mut failed: int = 0;
    var cli: Cli = optionCli();
    var spaced: Matches = good(cli: cli, argv: ["--output", "a.txt"]);
    failed = failed + checkEq(
        label: "--name value",
        actual: spaced.getStr(name: "output").unwrapOr(fallback: "?"),
        expected: "a.txt",
    );
    var equals: Matches = good(cli: cli, argv: ["--output=b.txt"]);
    failed = failed + checkEq(
        label: "--name=value",
        actual: equals.getStr(name: "output").unwrapOr(fallback: "?"),
        expected: "b.txt",
    );
    var emptyValue: Matches = good(cli: cli, argv: ["--output="]);
    failed = failed + checkEq(
        label: "--name= is an empty value",
        actual: emptyValue.getStr(name: "output").unwrapOr(fallback: "?"),
        expected: "",
    );
    var shortSpaced: Matches = good(cli: cli, argv: ["-o", "c.txt"]);
    failed = failed + checkEq(
        label: "-o value",
        actual: shortSpaced.getStr(name: "output").unwrapOr(fallback: "?"),
        expected: "c.txt",
    );
    var shortAttached: Matches = good(cli: cli, argv: ["-od.txt"]);
    failed = failed + checkEq(
        label: "-ovalue",
        actual: shortAttached.getStr(name: "output").unwrapOr(fallback: "?"),
        expected: "d.txt",
    );
    var shortEquals: Matches = good(cli: cli, argv: ["-o=e.txt"]);
    failed = failed + checkEq(
        label: "-o=value",
        actual: shortEquals.getStr(name: "output").unwrapOr(fallback: "?"),
        expected: "e.txt",
    );
    var clustered: Matches = good(cli: cli, argv: ["-ao", "f.txt"]);
    failed = failed + check(
        label: "flag then option in one cluster",
        condition: clustered.flag(name: "all")
            && clustered.getStr(name: "output").unwrap() == "f.txt",
    );
    var viaAlias: Matches = good(cli: cli, argv: ["--out", "g.txt"]);
    failed = failed + checkEq(
        label: "long alias",
        actual: viaAlias.getStr(name: "output").unwrapOr(fallback: "?"),
        expected: "g.txt",
    );
    failed = failed + check(
        label: "missing value at the end",
        condition: failsWith(
            cli: cli,
            argv: ["--output"],
            kind: ParseErrorKind::MissingValue,
        ),
    );
    failed = failed + check(
        label: "option followed by an option",
        condition: failsWith(
            cli: cli,
            argv: ["--output", "--all"],
            kind: ParseErrorKind::MissingValue,
        ),
    );
    failed = failed + check(
        label: "duplicate option is rejected",
        condition: failsWith(
            cli: cli,
            argv: ["-o", "a", "-o", "b"],
            kind: ParseErrorKind::DuplicateArgument,
        ),
    );
    var defaults: Matches = good(cli: cli, argv: []);
    failed = failed + check(
        label: "default value present",
        condition: defaults.getInt(name: "level").unwrap() == 3,
    );
    failed = failed + check(
        label: "has() sees defaults",
        condition: defaults.has(name: "level"),
    );
    failed = failed + check(
        label: "given() ignores defaults",
        condition: !defaults.given(name: "level"),
    );
    failed = failed + check(
        label: "no default means no value",
        condition: !defaults.has(name: "output"),
    );
    var overridden: Matches = good(cli: cli, argv: ["--level", "9"]);
    failed = failed + check(
        label: "default is replaced",
        condition: overridden.getInt(name: "level").unwrap() == 9
            && overridden.getList(name: "level").length() == 1,
    );
    failed = failed + check(
        label: "int",
        condition: good(cli: cli, argv: ["--level", "-12"])
            .getInt(name: "level")
            .unwrap() == -12,
    );
    failed = failed + check(
        label: "int must be numeric",
        condition: failsWith(
            cli: cli,
            argv: ["--level", "abc"],
            kind: ParseErrorKind::InvalidValue,
        ),
    );
    failed = failed + check(
        label: "int rejects decimals",
        condition: failsWith(
            cli: cli,
            argv: ["--level", "1.5"],
            kind: ParseErrorKind::InvalidValue,
        ),
    );
    failed = failed + check(
        label: "float",
        condition: good(cli: cli, argv: ["--ratio", "0.25"])
            .getFloat(name: "ratio")
            .unwrap() == 0.25,
    );
    failed = failed + check(
        label: "float accepts ints",
        condition: good(cli: cli, argv: ["--ratio", "2"])
            .getFloat(name: "ratio")
            .unwrap() == 2.0,
    );
    failed = failed + check(
        label: "float must be numeric",
        condition: failsWith(
            cli: cli,
            argv: ["--ratio", "x"],
            kind: ParseErrorKind::InvalidValue,
        ),
    );
    failed = failed + check(
        label: "bool yes",
        condition: good(cli: cli, argv: ["--enabled", "yes"])
            .getBool(name: "enabled")
            .unwrap(),
    );
    failed = failed + check(
        label: "bool off",
        condition: !good(cli: cli, argv: ["--enabled=off"])
            .getBool(name: "enabled")
            .unwrap(),
    );
    failed = failed + check(
        label: "bool is canonicalized",
        condition: good(cli: cli, argv: ["--enabled", "YES"])
            .getStr(name: "enabled")
            .unwrap() == "true",
    );
    failed = failed + check(
        label: "bool must be a boolean",
        condition: failsWith(
            cli: cli,
            argv: ["--enabled", "maybe"],
            kind: ParseErrorKind::InvalidValue,
        ),
    );
    var tagged: Matches = good(
        cli: cli,
        argv: ["-t", "a", "--tag", "b", "-tc"],
    );
    failed = failed + check(
        label: "repeatable collects in order",
        condition: tagged.getList(name: "tag").join(separator: ",") == "a,b,c",
    );
    failed = failed + check(
        label: "occurrences counted",
        condition: tagged.count(name: "tag") == 3,
    );
    failed = failed + checkEq(
        label: "getStr reads the last value",
        actual: tagged.getStr(name: "tag").unwrap(),
        expected: "c",
    );
    var delimited: Matches = good(cli: cli, argv: ["--tags", "x,y,z"]);
    failed = failed + check(
        label: "delimiter splits one token",
        condition: delimited.getList(name: "tags").length() == 3,
    );
    var pair: Matches = good(cli: cli, argv: ["--point", "3", "4"]);
    failed = failed + check(
        label: "min/max values take several tokens",
        condition: pair.getInts(name: "point").length() == 2
            && pair.getInts(name: "point")[1] == 4,
    );
    failed = failed + check(
        label: "too few values",
        condition: failsWith(
            cli: cli,
            argv: ["--point", "3"],
            kind: ParseErrorKind::TooFewValues,
        ),
    );
    failed = failed + check(
        label: "negative numbers are values",
        condition: good(cli: cli, argv: ["--offset", "-5"])
            .getInt(name: "offset")
            .unwrap() == -5,
    );
    failed = failed + check(
        label: "hyphen values need permission",
        condition: failsWith(
            cli: cli,
            argv: ["--output", "-x"],
            kind: ParseErrorKind::MissingValue,
        ),
    );
    failed = failed + check(
        label: "allowHyphenValue",
        condition: good(cli: cli, argv: ["--pattern", "--weird"])
            .getStr(name: "pattern")
            .unwrap() == "--weird",
    );
    return failed;
};

fn choiceCli() -> Cli {
    return Cli(
        name: "t",
        options: [
            ArgOption(
                name: "format",
                long: "format",
                choices: [
                    Choice(value: "json", aliases: ["j"]),
                    Choice(value: "yaml"),
                    Choice(value: "secret", hidden: true)
                ],
            )
        ],
    );
};

fn choices() -> int {
    var mut failed: int = 0;
    var cli: Cli = choiceCli();
    failed = failed + checkEq(
        label: "exact choice",
        actual: good(cli: cli, argv: ["--format", "yaml"])
            .getStr(name: "format")
            .unwrap(),
        expected: "yaml",
    );
    failed = failed + checkEq(
        label: "alias resolves to the canonical value",
        actual: good(cli: cli, argv: ["--format", "j"])
            .getStr(name: "format")
            .unwrap(),
        expected: "json",
    );
    failed = failed + check(
        label: "unknown choice",
        condition: failsWith(
            cli: cli,
            argv: ["--format", "xml"],
            kind: ParseErrorKind::InvalidChoice,
        ),
    );
    failed = failed + check(
        label: "hidden choices stay out of the message",
        condition: !failsWith(
            cli: cli,
            argv: ["--format", "xml"],
            kind: ParseErrorKind::InvalidValue,
        ),
    );
    failed = failed + check(
        label: "choices are case sensitive by default",
        condition: failsWith(
            cli: cli,
            argv: ["--format", "JSON"],
            kind: ParseErrorKind::InvalidChoice,
        ),
    );
    var relaxed: Cli = Cli(
        name: "t",
        options: cli.options,
        settings: CliSettings(caseSensitive: false),
    );
    failed = failed + checkEq(
        label: "case-insensitive choices",
        actual: good(cli: relaxed, argv: ["--format", "JSON"])
            .getStr(name: "format")
            .unwrap(),
        expected: "json",
    );
    failed = failed + checkEq(
        label: "case-insensitive long names",
        actual: good(cli: relaxed, argv: ["--FORMAT", "yaml"])
            .getStr(name: "format")
            .unwrap(),
        expected: "yaml",
    );
    return failed;
};

fn settings() -> int {
    var mut failed: int = 0;
    var noEquals: Cli = Cli(
        name: "t",
        options: [ArgOption(name: "o", long: "out")],
        settings: CliSettings(allowLongEquals: false),
    );
    failed = failed + check(
        label: "--name=value off: treated as an unknown name",
        condition: failsWith(
            cli: noEquals,
            argv: ["--out=x"],
            kind: ParseErrorKind::UnknownArgument,
        ),
    );
    failed = failed + check(
        label: "--name value still works",
        condition: succeeds(cli: noEquals, argv: ["--out", "x"]),
    );
    var lenient: Cli = Cli(
        name: "t",
        flags: [Flag(name: "a", short: "a")],
        settings: CliSettings(allowUnknownArguments: true),
    );
    var loose: Matches = good(
        cli: lenient,
        argv: ["--mystery", "-a", "-z", "stray"],
    );
    failed = failed + check(
        label: "unknown arguments are collected",
        condition: loose.unknown.length() == 3,
    );
    failed = failed + check(
        label: "known arguments still parse",
        condition: loose.flag(name: "a"),
    );
    return failed;
};

fn main() -> int {
    var mut bad: int = 0;
    bad = bad + report(suite: "flags", failures: flags());
    bad = bad + report(suite: "options", failures: options());
    bad = bad + report(suite: "choices", failures: choices());
    bad = bad + report(suite: "settings", failures: settings());
    return bad;
};
