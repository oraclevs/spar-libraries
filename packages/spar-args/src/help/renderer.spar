import { Cli } from "../config/cli.spar";
import { ArgOption } from "../config/option.spar";
import { Flag } from "../config/flag.spar";
import { Positional } from "../config/positional.spar";
import { Choice } from "../config/choice.spar";
import { SubCommand } from "../config/command.spar";
import { Scope, buildScope, findCommand } from "../internal/arg_spec.spar";
import { padRight } from "../internal/text.spar";
import {
    renderUsage,
    optionValueName,
    positionalValueName,
    positionalLabel
} from "./usage.spar";

struct Row {
    left: str;
    right: str = "";
};

fn visibleChoices(choices: List<Choice>) -> List<str> {
    var mut out: List<str> = [];
    for choice in choices {
        if !choice.hidden {
            out.append(value: choice.value);
        }
    }
    return out;
};

// The notes appended to an argument's help: defaults, choices, aliases and
// deprecation.
fn notes(
    cli: Cli,
    help: str,
    defaults: List<str>,
    choices: List<Choice>,
    aliases: List<str>,
    deprecated: str,
) -> str {
    var mut text: str = help;
    if cli.help.showDefaults && defaults.length() > 0 {
        var joined: str = defaults.join(separator: ", ");
        text = text + " [default: ${joined}]";
    }
    var shown: List<str> = visibleChoices(choices: choices);
    if cli.help.showChoices && shown.length() > 0 {
        var joined: str = shown.join(separator: ", ");
        text = text + " [possible values: ${joined}]";
    }
    if cli.help.showAliases && aliases.length() > 0 {
        var joined: str = aliases.join(separator: ", ");
        text = text + " [aliases: ${joined}]";
    }
    if deprecated != "" {
        text = text + " (deprecated: ${deprecated})";
    }
    return text.trim();
};

fn spellings(short: str, long: str) -> str {
    if short != "" && long != "" {
        return "-${short}, --${long}";
    }
    if short != "" {
        return "-${short}";
    }
    return "    --${long}";
};

fn longAliasText(aliases: List<str>) -> List<str> {
    var mut out: List<str> = [];
    for alias in aliases {
        out.append(value: "--${alias}");
    }
    return out;
};

fn optionRow(cli: Cli, option: ArgOption) -> Row {
    var mut left: str = spellings(short: option.short, long: option.long);
    var valueName: str = optionValueName(option: option);
    left = left + " <${valueName}>";
    var mut text: str = option.help;
    if option.longHelp != "" {
        text = option.longHelp;
    }
    var right: str = notes(
        cli: cli,
        help: text,
        defaults: option.defaultValues,
        choices: option.choices,
        aliases: longAliasText(aliases: option.aliases),
        deprecated: option.deprecated,
    );
    return Row(left: left, right: right);
};

fn flagRow(cli: Cli, flag: Flag) -> Row {
    var left: str = spellings(short: flag.short, long: flag.long);
    var mut text: str = flag.help;
    if flag.longHelp != "" {
        text = flag.longHelp;
    }
    var right: str = notes(
        cli: cli,
        help: text,
        defaults: [],
        choices: [],
        aliases: longAliasText(aliases: flag.aliases),
        deprecated: flag.deprecated,
    );
    return Row(left: left, right: right);
};

fn positionalRow(cli: Cli, positional: Positional) -> Row {
    var mut text: str = positional.help;
    if positional.longHelp != "" {
        text = positional.longHelp;
    }
    var right: str = notes(
        cli: cli,
        help: text,
        defaults: positional.defaultValues,
        choices: positional.choices,
        aliases: [],
        deprecated: "",
    );
    return Row(
        left: positionalLabel(positional: positional),
        right: right,
    );
};

fn commandRow(cli: Cli, sub: SubCommand) -> Row {
    var right: str = notes(
        cli: cli,
        help: sub.about,
        defaults: [],
        choices: [],
        aliases: sub.aliases,
        deprecated: "",
    );
    return Row(left: sub.name, right: right);
};

fn renderRows(title: str, rows: List<Row>) -> str {
    if rows.length() == 0 {
        return "";
    }
    var mut width: int = 0;
    for row in rows {
        if row.left.length() > width {
            width = row.left.length();
        }
    }
    var mut text: str = "${title}:";
    for row in rows {
        var mut line: str = "  " + padRight(text: row.left, width: width);
        if row.right != "" {
            line = line + "  " + row.right;
        }
        text = text + "\n" + line.trimEnd();
    }
    return text + "\n";
};

fn helpEnabled(cli: Cli) -> bool {
    return cli.help.enabled && cli.settings.autoHelp;
};

fn versionEnabled(cli: Cli, path: List<str>) -> bool {
    return path.length() == 0 && cli.version != "" && cli.settings.autoVersion;
};

fn aboutText(cli: Cli, path: List<str>) -> str {
    if path.length() == 0 {
        if cli.longAbout != "" {
            return cli.longAbout;
        }
        return cli.about;
    }
    var found: Option<SubCommand> = findCommand(cli: cli, path: path);
    if found.isNone() {
        return "";
    }
    if found.unwrap().longAbout != "" {
        return found.unwrap().longAbout;
    }
    return found.unwrap().about;
};

fn renderHelp(cli: Cli, path: List<str>) -> str {
    var scope: Scope = buildScope(cli: cli, path: path);
    var mut sections: List<str> = [];
    if cli.help.beforeHelp != "" {
        sections.append(value: cli.help.beforeHelp);
    }
    var about: str = aboutText(cli: cli, path: path);
    if about != "" {
        sections.append(value: about);
    }
    sections.append(value: renderUsage(cli: cli, path: path));
    var mut commandRows: List<Row> = [];
    for sub in scope.children {
        if !sub.hidden {
            commandRows.append(value: commandRow(cli: cli, sub: sub));
        }
    }
    sections.append(
        value: renderRows(title: "Commands", rows: commandRows).trimEnd(),
    );
    var mut positionalRows: List<Row> = [];
    for positional in scope.positionals {
        positionalRows.append(value: positionalRow(
            cli: cli,
            positional: positional,
        ));
    }
    sections.append(
        value: renderRows(title: "Arguments", rows: positionalRows).trimEnd(),
    );
    var mut optionRows: List<Row> = [];
    for option in scope.options {
        if !option.hidden {
            optionRows.append(value: optionRow(cli: cli, option: option));
        }
    }
    for flag in scope.flags {
        if !flag.hidden {
            optionRows.append(value: flagRow(cli: cli, flag: flag));
        }
    }
    if helpEnabled(cli: cli) {
        var helpShort: str = cli.help.short;
        optionRows.append(value: Row(
            left: spellings(short: helpShort, long: cli.help.long),
            right: "Print help",
        ));
    }
    if versionEnabled(cli: cli, path: path) {
        optionRows.append(value: Row(
            left: spellings(short: "V", long: "version"),
            right: "Print version",
        ));
    }
    sections.append(
        value: renderRows(title: "Options", rows: optionRows).trimEnd(),
    );
    if cli.help.afterHelp != "" {
        sections.append(value: cli.help.afterHelp);
    }
    var mut kept: List<str> = [];
    for piece in sections {
        if piece != "" {
            kept.append(value: piece);
        }
    }
    return kept.join(separator: "\n\n");
};
