export enum ParseErrorKind {
    UnknownArgument,
    UnknownCommand,
    MissingValue,
    TooFewValues,
    TooManyValues,
    UnexpectedValue,
    UnexpectedPositional,
    InvalidValue,
    InvalidChoice,
    MissingRequired,
    DuplicateArgument,
    ConflictingArguments,
    MissingRequirement,
    GroupViolation,
    InvalidConfiguration,
    HelpRequested,
    VersionRequested
};

// Why parsing stopped. HelpRequested and VersionRequested are not failures:
// their `message` holds the text to print on stdout and exitCode() is 0.
export struct ParseError {
    kind: ParseErrorKind;
    message: str;
    argument: str = "";
    path: List<str> = [];
    suggestion: str = "";
    usage: str = "";
};

impl ParseError {
    fn isHelp(self) -> bool {
        return self.kind == ParseErrorKind::HelpRequested;
    };
    fn isVersion(self) -> bool {
        return self.kind == ParseErrorKind::VersionRequested;
    };
    fn isFailure(self) -> bool {
        return self.kind != ParseErrorKind::HelpRequested
            && self.kind != ParseErrorKind::VersionRequested;
    };
    fn exitCode(self) -> int {
        if self.isFailure() {
            return 2;
        }
        return 0;
    };
    fn render(self) -> str {
        // The text a command line tool would print for this error.
        if !self.isFailure() {
            return self.message;
        }
        var mut text: str = "error: ${self.message}";
        if self.suggestion != "" {
            text = text + "\n\n  tip: did you mean '${self.suggestion}'?";
        }
        if self.usage != "" {
            text = text + "\n\n${self.usage}";
        }
        return text;
    };
};
