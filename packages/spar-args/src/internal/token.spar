export enum TokenKind {
    Word,
    Long,
    Short,
    DoubleDash
};

// One command line entry after classification.
//   Word        any plain value or subcommand name (also "-" and "-5")
//   Long        --name or --name=value    (name without dashes, `attached` after '=')
//   Short       -x, -xyz or -xVALUE       (name is everything after the dash)
//   DoubleDash  a bare "--"
// `raw` is always the original text.
export struct Token {
    kind: TokenKind;
    raw: str;
    name: str = "";
    attached: Option<str> = none();
};
