import { Cli } from "../config/cli.spar";
import { ValueSpec, ValueKind } from "../config/value_spec.spar";
import { Choice } from "../config/choice.spar";
import { ParseError } from "../result/parse_error.spar";
import { canonicalize, kindName } from "../internal/value.spar";
import { sameText, listContains } from "../internal/text.spar";
import { invalidValue, invalidChoice } from "./errors.spar";

fn splitValue(raw: str, delimiter: str) -> List<str> {
    if delimiter == "" {
        return [raw];
    }
    return raw.split(separator: delimiter);
};

// The accepted spellings of every visible choice, for error messages.
fn choiceNames(choices: List<Choice>) -> List<str> {
    var mut out: List<str> = [];
    for choice in choices {
        if !choice.hidden {
            out.append(value: choice.value);
        }
    }
    return out;
};

fn resolveChoice(
    text: str,
    choices: List<Choice>,
    caseSensitive: bool,
) -> Option<str> {
    for choice in choices {
        if sameText(
            left: choice.value,
            right: text,
            caseSensitive: caseSensitive,
        )
            || listContains(
                items: choice.aliases,
                wanted: text,
                caseSensitive: caseSensitive,
            ) {
            return some(value: choice.value);
        }
    }
    return none();
};

// Splits `raw` on the delimiter, checks every piece against the value type
// and the allowed choices, and returns the canonical values to store.
fn convertValues(
    cli: Cli,
    path: List<str>,
    raw: str,
    spec: ValueSpec,
    choices: List<Choice>,
    spelled: str,
) -> Result<List<str>, ParseError> {
    var mut out: List<str> = [];
    for piece in splitValue(raw: raw, delimiter: spec.delimiter) {
        var checked: Option<str> = canonicalize(text: piece, kind: spec.kind);
        if checked.isNone() {
            return err<List<str>, ParseError>(error: invalidValue(
                cli: cli,
                path: path,
                spelled: spelled,
                value: piece,
                expected: kindName(kind: spec.kind),
            ));
        }
        var mut stored: str = checked.unwrap();
        if choices.length() > 0 {
            var chosen: Option<str> = resolveChoice(
                text: stored,
                choices: choices,
                caseSensitive: cli.settings.caseSensitive,
            );
            if chosen.isNone() {
                return err<List<str>, ParseError>(error: invalidChoice(
                    cli: cli,
                    path: path,
                    spelled: spelled,
                    value: piece,
                    allowed: choiceNames(choices: choices),
                ));
            }
            stored = chosen.unwrap();
        }
        out.append(value: stored);
    }
    return ok<List<str>, ParseError>(value: out);
};
