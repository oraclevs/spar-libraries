import { Cli } from "../config/cli.spar";
import { SubCommand } from "../config/command.spar";
import { ArgOption } from "../config/option.spar";
import { Flag, FlagAction } from "../config/flag.spar";
import { Positional } from "../config/positional.spar";
import { ValueSpec } from "../config/value_spec.spar";
import { ArgMatch } from "../result/match.spar";
import { Matches } from "../result/matches.spar";
import { ParseError } from "../result/parse_error.spar";
import { Token, TokenKind } from "../internal/token.spar";
import {
    Scope,
    buildScope,
    findChild,
    findLongOption,
    findLongFlag,
    findShortOption,
    findShortFlag,
    longSpellings,
    commandSpellings
} from "../internal/arg_spec.spar";
import {
    charAt,
    dropPrefix,
    sameText,
    closest
} from "../internal/text.spar";
import { helpEnabled, versionEnabled } from "../help/renderer.spar";
import { positionalLabel } from "../help/usage.spar";
import { normalize } from "./normalize.spar";
import { convertValues } from "./convert.spar";
import { checkCli, finalize } from "./validate.spar";
import {
    unknownArgument,
    unknownCommand,
    missingValue,
    tooFewValues,
    unexpectedValue,
    unexpectedPositional,
    duplicateArgument,
    invalidConfiguration,
    helpRequested,
    versionRequested
} from "./errors.spar";
import pkg { args, exit } from "std/process";
import pkg { eprintln } from "std/io";

struct ParseState {
    path: List<str> = [];
    scope: Scope;
    matches: Matches = Matches();
    words: List<str> = [];
    pastDoubleDash: bool = false;
};

// The state after handling one token, and where the next token starts.
struct Step {
    state: ParseState;
    next: int;
};

struct Taken {
    values: List<str>;
    next: int;
};

fn stepOk(state: ParseState, next: int) -> Result<Step, ParseError> {
    return ok<Step, ParseError>(value: Step(state: state, next: next));
};

fn stepErr(error: ParseError) -> Result<Step, ParseError> {
    return err<Step, ParseError>(error: error);
};

fn entryFor(state: ParseState, name: str) -> ArgMatch {
    var existing: Option<ArgMatch> = state.matches.args.get(key: name);
    if existing.isSome() {
        return existing.unwrap();
    }
    return ArgMatch(name: name);
};

fn warn(state: ParseState, spelled: str, deprecated: str) -> ParseState {
    var mut next: ParseState = state;
    if deprecated != "" {
        next.matches.warnings.append(
            value: "'${spelled}' is deprecated: ${deprecated}",
        );
    }
    return next;
};

fn applyFlag(state: ParseState, flag: Flag, spelled: str) -> ParseState {
    var mut entry: ArgMatch = entryFor(state: state, name: flag.name);
    entry.occurrences = entry.occurrences + 1;
    entry.explicit = true;
    if flag.action == FlagAction::SetTrue {
        entry.values = ["true"];
    } else if flag.action == FlagAction::SetFalse {
        entry.values = ["false"];
    } else {
        entry.values = ["${entry.occurrences}"];
    }
    var mut next: ParseState = warn(
        state: state,
        spelled: spelled,
        deprecated: flag.deprecated,
    );
    next.matches.args.insert(key: flag.name, value: entry);
    return next;
};

fn applyOption(
    cli: Cli,
    state: ParseState,
    option: ArgOption,
    values: List<str>,
    spelled: str,
) -> Result<ParseState, ParseError> {
    var mut entry: ArgMatch = entryFor(state: state, name: option.name);
    if entry.explicit && !option.repeatable {
        return err<ParseState, ParseError>(error: duplicateArgument(
            cli: cli,
            path: state.path,
            spelled: spelled,
        ));
    }
    for value in values {
        entry.values.append(value: value);
    }
    entry.occurrences = entry.occurrences + 1;
    entry.explicit = true;
    var mut next: ParseState = warn(
        state: state,
        spelled: spelled,
        deprecated: option.deprecated,
    );
    next.matches.args.insert(key: option.name, value: entry);
    return ok<ParseState, ParseError>(value: next);
};

fn acceptsAsValue(token: Token, spec: ValueSpec) -> bool {
    if token.kind == TokenKind::Word {
        return true;
    }
    if token.kind == TokenKind::DoubleDash {
        return false;
    }
    return spec.allowHyphenValue;
};

// Reads the value(s) of an option: the attached `--name=value` or `-nvalue`
// text, or the following tokens.
fn takeValues(
    cli: Cli,
    state: ParseState,
    option: ArgOption,
    spelled: str,
    attached: Option<str>,
    tokens: List<Token>,
    start: int,
) -> Result<Taken, ParseError> {
    var spec: ValueSpec = option.value;
    var mut vmin: int = spec.minValues;
    if vmin < 1 {
        vmin = 1;
    }
    var vmax: int = spec.maxValues;
    var mut values: List<str> = [];
    var mut next: int = start;
    var mut taken: int = 0;
    if attached.isSome() {
        var converted: Result<List<str>, ParseError> = convertValues(
            cli: cli,
            path: state.path,
            raw: attached.unwrap(),
            spec: spec,
            choices: option.choices,
            spelled: spelled,
        );
        if converted.isErr() {
            return err<Taken, ParseError>(error: converted.unwrapErr());
        }
        for value in converted.unwrap() {
            values.append(value: value);
        }
        taken = 1;
    } else {
        if next >= tokens.length()
            || !acceptsAsValue(token: tokens[next], spec: spec) {
            return err<Taken, ParseError>(error: missingValue(
                cli: cli,
                path: state.path,
                spelled: spelled,
            ));
        }
    }
    while (vmax == 0 || taken < vmax)
        && (attached.isNone() || taken < vmin)
        && next < tokens.length()
        && acceptsAsValue(token: tokens[next], spec: spec) {
        var converted: Result<List<str>, ParseError> = convertValues(
            cli: cli,
            path: state.path,
            raw: tokens[next].raw,
            spec: spec,
            choices: option.choices,
            spelled: spelled,
        );
        if converted.isErr() {
            return err<Taken, ParseError>(error: converted.unwrapErr());
        }
        for value in converted.unwrap() {
            values.append(value: value);
        }
        next = next + 1;
        taken = taken + 1;
    }
    if taken < vmin {
        return err<Taken, ParseError>(error: tooFewValues(
            cli: cli,
            path: state.path,
            spelled: spelled,
            need: vmin,
            got: taken,
        ));
    }
    return ok<Taken, ParseError>(value: Taken(values: values, next: next));
};

// Reads and applies one option occurrence.
fn consumeOption(
    cli: Cli,
    state: ParseState,
    option: ArgOption,
    spelled: str,
    attached: Option<str>,
    tokens: List<Token>,
    start: int,
) -> Result<Step, ParseError> {
    var taken: Result<Taken, ParseError> = takeValues(
        cli: cli,
        state: state,
        option: option,
        spelled: spelled,
        attached: attached,
        tokens: tokens,
        start: start,
    );
    if taken.isErr() {
        return stepErr(error: taken.unwrapErr());
    }
    var applied: Result<ParseState, ParseError> = applyOption(
        cli: cli,
        state: state,
        option: option,
        values: taken.unwrap().values,
        spelled: spelled,
    );
    if applied.isErr() {
        return stepErr(error: applied.unwrapErr());
    }
    return stepOk(state: applied.unwrap(), next: taken.unwrap().next);
};

fn recordUnknown(state: ParseState, raw: str) -> ParseState {
    var mut next: ParseState = state;
    next.matches.unknown.append(value: raw);
    return next;
};

fn handleLong(
    cli: Cli,
    state: ParseState,
    tokens: List<Token>,
    index: int,
) -> Result<Step, ParseError> {
    var token: Token = tokens[index];
    var name: str = token.name;
    var caseSensitive: bool = cli.settings.caseSensitive;
    var spelled: str = "--${name}";
    var option: Option<ArgOption> = findLongOption(
        scope: state.scope,
        name: name,
        caseSensitive: caseSensitive,
    );
    if option.isSome() {
        return consumeOption(
            cli: cli,
            state: state,
            option: option.unwrap(),
            spelled: spelled,
            attached: token.attached,
            tokens: tokens,
            start: index + 1,
        );
    }
    var flag: Option<Flag> = findLongFlag(
        scope: state.scope,
        name: name,
        caseSensitive: caseSensitive,
    );
    if flag.isSome() {
        if token.attached.isSome() {
            return stepErr(error: unexpectedValue(
                cli: cli,
                path: state.path,
                spelled: spelled,
                value: token.attached.unwrap(),
            ));
        }
        return stepOk(
            state: applyFlag(
                state: state,
                flag: flag.unwrap(),
                spelled: spelled,
            ),
            next: index + 1,
        );
    }
    if helpEnabled(cli: cli)
        && cli.help.long != ""
        && sameText(
            left: name,
            right: cli.help.long,
            caseSensitive: caseSensitive,
        ) {
        return stepErr(error: helpRequested(cli: cli, path: state.path));
    }
    if versionEnabled(cli: cli, path: state.path)
        && sameText(
            left: name,
            right: "version",
            caseSensitive: caseSensitive,
        ) {
        return stepErr(error: versionRequested(cli: cli));
    }
    if cli.settings.allowUnknownArguments {
        return stepOk(
            state: recordUnknown(state: state, raw: token.raw),
            next: index + 1,
        );
    }
    var near: str = closest(
        name: name,
        candidates: longSpellings(scope: state.scope),
    );
    var mut suggestion: str = "";
    if near != "" {
        suggestion = "--${near}";
    }
    return stepErr(error: unknownArgument(
        cli: cli,
        path: state.path,
        spelled: token.raw,
        suggestion: suggestion,
    ));
};

fn handleShort(
    cli: Cli,
    state: ParseState,
    tokens: List<Token>,
    index: int,
) -> Result<Step, ParseError> {
    var token: Token = tokens[index];
    var cluster: str = token.name;
    var mut current: ParseState = state;
    var mut next: int = index + 1;
    if !cli.settings.allowCombinedShortFlags && cluster.length() > 1 {
        if cli.settings.allowUnknownArguments {
            return stepOk(
                state: recordUnknown(state: state, raw: token.raw),
                next: next,
            );
        }
        return stepErr(error: unknownArgument(
            cli: cli,
            path: state.path,
            spelled: token.raw,
            suggestion: "",
        ));
    }
    var mut j: int = 0;
    while j < cluster.length() {
        var letter: str = charAt(text: cluster, index: j);
        var spelled: str = "-${letter}";
        var flag: Option<Flag> = findShortFlag(
            scope: current.scope,
            letter: letter,
        );
        if flag.isSome() {
            current = applyFlag(
                state: current,
                flag: flag.unwrap(),
                spelled: spelled,
            );
            j = j + 1;
            continue;
        }
        var option: Option<ArgOption> = findShortOption(
            scope: current.scope,
            letter: letter,
        );
        if option.isSome() {
            var mut attached: Option<str> = none();
            if j + 1 < cluster.length() {
                var mut rest: str = dropPrefix(text: cluster, count: j + 1);
                if rest.startsWith(prefix: "=")
                    && cli.settings.allowLongEquals {
                    rest = dropPrefix(text: rest, count: 1);
                }
                attached = some(value: rest);
            }
            var consumed: Result<Step, ParseError> = consumeOption(
                cli: cli,
                state: current,
                option: option.unwrap(),
                spelled: spelled,
                attached: attached,
                tokens: tokens,
                start: next,
            );
            if consumed.isErr() {
                return consumed;
            }
            current = consumed.unwrap().state;
            next = consumed.unwrap().next;
            break;
        }
        if helpEnabled(cli: cli)
            && cli.help.short != ""
            && letter == cli.help.short {
            return stepErr(error: helpRequested(cli: cli, path: current.path));
        }
        if versionEnabled(cli: cli, path: current.path) && letter == "V" {
            return stepErr(error: versionRequested(cli: cli));
        }
        if cli.settings.allowUnknownArguments {
            current = recordUnknown(state: current, raw: token.raw);
            break;
        }
        return stepErr(error: unknownArgument(
            cli: cli,
            path: current.path,
            spelled: spelled,
            suggestion: "",
        ));
    }
    return stepOk(state: current, next: next);
};

fn descend(cli: Cli, state: ParseState, sub: SubCommand) -> ParseState {
    var mut next: ParseState = state;
    var mut path: List<str> = state.path;
    path.append(value: sub.name);
    next.path = path;
    next.scope = buildScope(cli: cli, path: path);
    return next;
};

// A plain word is a subcommand name when the current command has children
// and no positional word has been seen yet; otherwise it is a positional.
fn handleWord(
    cli: Cli,
    state: ParseState,
    token: Token,
    afterDashes: bool,
) -> Result<ParseState, ParseError> {
    var mut next: ParseState = state;
    if !afterDashes
        && state.words.length() == 0
        && state.scope.children.length() > 0 {
        var child: Option<SubCommand> = findChild(
            cli: cli,
            path: state.path,
            word: token.raw,
        );
        if child.isSome() {
            return ok<ParseState, ParseError>(value: descend(
                cli: cli,
                state: state,
                sub: child.unwrap(),
            ));
        }
        if state.scope.positionals.length() == 0 {
            if cli.settings.allowUnknownArguments {
                return ok<ParseState, ParseError>(value: recordUnknown(
                    state: state,
                    raw: token.raw,
                ));
            }
            var near: str = closest(
                name: token.raw,
                candidates: commandSpellings(scope: state.scope),
            );
            return err<ParseState, ParseError>(error: unknownCommand(
                cli: cli,
                path: state.path,
                word: token.raw,
                suggestion: near,
            ));
        }
    }
    next.words.append(value: token.raw);
    return ok<ParseState, ParseError>(value: next);
};

fn requiredAfter(positionals: List<Positional>, index: int) -> int {
    var mut total: int = 0;
    var mut k: int = index + 1;
    while k < positionals.length() {
        var later: Positional = positionals[k];
        if later.required {
            var mut least: int = later.value.minValues;
            if least < 1 {
                least = 1;
            }
            total = total + least;
        }
        k = k + 1;
    }
    return total;
};

// Hands the collected words to the positionals in order. A positional with
// maxValues != 1 (or `trailing`) takes as many as it can while leaving enough
// for the required ones after it.
fn assignPositionals(
    cli: Cli,
    state: ParseState,
) -> Result<ParseState, ParseError> {
    var mut current: ParseState = state;
    var positionals: List<Positional> = state.scope.positionals;
    var words: List<str> = state.words;
    var mut used: int = 0;
    var mut p: int = 0;
    while p < positionals.length() && used < words.length() {
        var positional: Positional = positionals[p];
        var remaining: int = words.length() - used;
        var reserve: int = requiredAfter(positionals: positionals, index: p);
        var mut take: int = remaining - reserve;
        var mut vmax: int = positional.value.maxValues;
        if positional.trailing {
            vmax = 0;
        }
        if vmax > 0 && take > vmax {
            take = vmax;
        }
        if take < 1 {
            p = p + 1;
            continue;
        }
        var mut vmin: int = positional.value.minValues;
        if vmin < 1 {
            vmin = 1;
        }
        var spelled: str = positionalLabel(positional: positional);
        if take < vmin {
            return err<ParseState, ParseError>(error: tooFewValues(
                cli: cli,
                path: state.path,
                spelled: spelled,
                need: vmin,
                got: take,
            ));
        }
        var mut entry: ArgMatch = ArgMatch(name: positional.name);
        var mut k: int = 0;
        while k < take {
            var converted: Result<List<str>, ParseError> = convertValues(
                cli: cli,
                path: state.path,
                raw: words[used + k],
                spec: positional.value,
                choices: positional.choices,
                spelled: spelled,
            );
            if converted.isErr() {
                return err<ParseState, ParseError>(
                    error: converted.unwrapErr(),
                );
            }
            for value in converted.unwrap() {
                entry.values.append(value: value);
            }
            k = k + 1;
        }
        entry.occurrences = 1;
        entry.explicit = true;
        current.matches.args.insert(key: positional.name, value: entry);
        used = used + take;
        p = p + 1;
    }
    while used < words.length() {
        if !cli.settings.allowUnknownArguments {
            return err<ParseState, ParseError>(error: unexpectedPositional(
                cli: cli,
                path: state.path,
                word: words[used],
            ));
        }
        current = recordUnknown(state: current, raw: words[used]);
        used = used + 1;
    }
    return ok<ParseState, ParseError>(value: current);
};

// Parses `argv` (the program arguments, without the program name).
// HelpRequested and VersionRequested come back as errors for which
// isFailure() is false.
fn parse(cli: Cli, argv: List<str>) -> Result<Matches, ParseError> {
    var problems: List<str> = checkCli(cli: cli);
    if problems.length() > 0 {
        return err<Matches, ParseError>(error: invalidConfiguration(
            problems: problems,
        ));
    }
    var tokens: List<Token> = normalize(argv: argv, settings: cli.settings);
    var mut state: ParseState = ParseState(scope: buildScope(
        cli: cli,
        path: [],
    ));
    var mut i: int = 0;
    while i < tokens.length() {
        var token: Token = tokens[i];
        if state.pastDoubleDash || token.kind == TokenKind::Word {
            var handled: Result<ParseState, ParseError> = handleWord(
                cli: cli,
                state: state,
                token: token,
                afterDashes: state.pastDoubleDash,
            );
            if handled.isErr() {
                return err<Matches, ParseError>(error: handled.unwrapErr());
            }
            state = handled.unwrap();
            i = i + 1;
        } else if token.kind == TokenKind::DoubleDash {
            if cli.settings.stopAtDoubleDash {
                state.pastDoubleDash = true;
            }
            i = i + 1;
        } else {
            var mut stepped: Result<Step, ParseError> = stepErr(
                error: unknownArgument(
                    cli: cli,
                    path: state.path,
                    spelled: token.raw,
                    suggestion: "",
                ),
            );
            if token.kind == TokenKind::Long {
                stepped = handleLong(
                    cli: cli,
                    state: state,
                    tokens: tokens,
                    index: i,
                );
            } else {
                stepped = handleShort(
                    cli: cli,
                    state: state,
                    tokens: tokens,
                    index: i,
                );
            }
            if stepped.isErr() {
                return err<Matches, ParseError>(error: stepped.unwrapErr());
            }
            state = stepped.unwrap().state;
            i = stepped.unwrap().next;
        }
    }
    var assigned: Result<ParseState, ParseError> = assignPositionals(
        cli: cli,
        state: state,
    );
    if assigned.isErr() {
        return err<Matches, ParseError>(error: assigned.unwrapErr());
    }
    var done: ParseState = assigned.unwrap();
    var mut matches: Matches = done.matches;
    matches.path = done.path;
    return finalize(cli: cli, scope: done.scope, matches: matches);
};

fn parseProgramArgs(cli: Cli) -> Result<Matches, ParseError> {
    return parse(cli: cli, argv: args());
};

// The usual entry point: parses the program arguments, prints help, version
// or errors, and exits when parsing does not succeed.
fn parseOrExit(cli: Cli) -> Matches {
    var result: Result<Matches, ParseError> = parseProgramArgs(cli: cli);
    if result.isOk() {
        for warning in result.unwrap().warnings {
            eprintln(value: "warning: ${warning}");
        }
        return result.unwrap();
    }
    var error: ParseError = result.unwrapErr();
    if error.isFailure() {
        eprintln(value: error.render());
    } else {
        println(value: error.message);
    }
    exit(code: error.exitCode());
    return Matches();
};
