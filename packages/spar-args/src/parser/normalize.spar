import { CliSettings } from "../config/settings.spar";
import { Token, TokenKind } from "../internal/token.spar";
import { dropPrefix, looksNegativeNumber } from "../internal/text.spar";

fn classify(entry: str, settings: CliSettings) -> Token {
    if entry == "--" {
        return Token(kind: TokenKind::DoubleDash, raw: entry);
    }
    if entry.startsWith(prefix: "--") {
        var body: str = dropPrefix(text: entry, count: 2);
        if settings.allowLongEquals {
            var at: Option<int> = body.indexOf(needle: "=");
            if at.isSome() {
                var cut: int = at.unwrap();
                return Token(
                    kind: TokenKind::Long,
                    raw: entry,
                    name: body.substring(start: 0, end: some(value: cut)),
                    attached: some(
                        value: body.substring(
                            start: cut + 1,
                            end: some(value: body.length()),
                        ),
                    ),
                );
            }
        }
        return Token(kind: TokenKind::Long, raw: entry, name: body);
    }
    if entry.startsWith(prefix: "-")
        && entry.length() > 1
        && !looksNegativeNumber(text: entry) {
        return Token(
            kind: TokenKind::Short,
            raw: entry,
            name: dropPrefix(text: entry, count: 1),
        );
    }
    return Token(kind: TokenKind::Word, raw: entry);
};

// Classifies every entry. Splitting `-abc` into letters or `-oVALUE` into
// option and value depends on the options in scope, so the parser does that.
fn normalize(argv: List<str>, settings: CliSettings) -> List<Token> {
    var mut tokens: List<Token> = [];
    for entry in argv {
        tokens.append(value: classify(entry: entry, settings: settings));
    }
    return tokens;
};
