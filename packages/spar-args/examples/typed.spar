// Typed values: integers, floats, booleans, choices with aliases, lists.
//
//   spar examples/typed.spar --size 3 --ratio 0.5 --mode fast --tags a,b,c
//   spar examples/typed.spar --point 3 4 --enabled yes
//   spar examples/typed.spar --mode turbo        (error: not a valid choice)
import { Cli } from "../src/config/cli.spar";
import { ArgOption } from "../src/config/option.spar";
import { Choice } from "../src/config/choice.spar";
import {
    ValueSpec,
    ValueKind,
    ValueCollection
} from "../src/config/value_spec.spar";
import { Matches } from "../src/result/matches.spar";
import { parseOrExit } from "../src/parser/parser.spar";

fn buildCli() -> Cli {
    return Cli(
        name: "typed",
        about: "Typed argument values",
        options: [
            ArgOption(
                name: "size",
                long: "size",
                value: ValueSpec(kind: ValueKind::Int),
                defaultValues: ["10"],
                help: "An integer",
            ),
            ArgOption(
                name: "ratio",
                long: "ratio",
                value: ValueSpec(kind: ValueKind::Float),
                help: "A decimal number",
            ),
            ArgOption(
                name: "enabled",
                long: "enabled",
                value: ValueSpec(kind: ValueKind::Bool),
                help: "true/false, yes/no, on/off, 1/0",
            ),
            ArgOption(
                name: "mode",
                long: "mode",
                choices: [
                    Choice(value: "fast", aliases: ["f"]),
                    Choice(value: "slow", aliases: ["s"])
                ],
                defaultValues: ["fast"],
                help: "Run mode",
            ),
            ArgOption(
                name: "tags",
                long: "tags",
                value: ValueSpec(
                    collection: ValueCollection::List,
                    delimiter: ",",
                ),
                help: "Comma separated tags",
            ),
            ArgOption(
                name: "point",
                long: "point",
                value: ValueSpec(
                    kind: ValueKind::Int,
                    collection: ValueCollection::List,
                    minValues: 2,
                    maxValues: 2,
                ),
                valueName: "X Y",
                help: "Two integers",
            )
        ],
    );
};

fn main() -> int {
    var m: Matches = parseOrExit(cli: buildCli());
    var size: int = m.getInt(name: "size").unwrap();
    var mode: str = m.getStr(name: "mode").unwrap();
    println(value: "size = ${size}");
    println(value: "mode = ${mode}");
    if m.has(name: "ratio") {
        var doubled: float = m.getFloat(name: "ratio").unwrap() * 2.0;
        println(value: "ratio * 2 = ${doubled}");
    }
    if m.has(name: "enabled") {
        var on: bool = m.getBool(name: "enabled").unwrap();
        println(value: "enabled = ${on}");
    }
    var tags: List<str> = m.getList(name: "tags");
    println(value: "tags = ${tags.length()}");
    var point: List<int> = m.getInts(name: "point");
    if point.length() == 2 {
        var sum: int = point[0] + point[1];
        println(value: "point sum = ${sum}");
    }
    return 0;
};
