import pkg {
    listen,
    listenTls,
    accept,
    close,
    setReadTimeout,
    read,
    writeText
} from "tcp";

export struct ServerRequest {
    method: str;
    target: str;
    version: str;
    headers: Map<str, str> = { };
    body: str = "";
};

export struct ServerResponse {
    status: int = 200;
    reason: str = "OK";
    contentType: str = "text/plain; charset=utf-8";
    headers: Map<str, str> = { };
    body: str = "";
};

fn decimal(text: str) -> int {
    var mut result: int = 0;
    var mut i: int = 0;
    if text.length() == 0 {
        panic(message: "empty Content-Length");
    }
    while i < text.length() {
        var digit: str = text.substring(start: i, end: some(value: i + 1));
        var mut value: int = -1;
        if digit == "0" {
            value = 0;
        }
        if digit == "1" {
            value = 1;
        }
        if digit == "2" {
            value = 2;
        }
        if digit == "3" {
            value = 3;
        }
        if digit == "4" {
            value = 4;
        }
        if digit == "5" {
            value = 5;
        }
        if digit == "6" {
            value = 6;
        }
        if digit == "7" {
            value = 7;
        }
        if digit == "8" {
            value = 8;
        }
        if digit == "9" {
            value = 9;
        }
        if value < 0 {
            panic(message: "invalid Content-Length");
        }
        result = result * 10 + value;
        if result > 1048576 {
            panic(message: "request body exceeds 1 MiB");
        }
        i = i + 1;
    }
    return result;
};

fn readRequest(connection: TcpConnectionHandle) -> ServerRequest {
    setReadTimeout(connection: connection, millis: 5000);
    var mut raw: Bytes = read(connection: connection, maxBytes: 4096);
    if raw.isEmpty() {
        panic(message: "connection closed before HTTP headers");
    }
    while raw.toUtf8().isErr()
        || raw.toUtf8().unwrap().indexOf(needle: "\r\n\r\n").isNone() {
        if raw.length() > 1056768 {
            panic(message: "HTTP request exceeds size limit");
        }
        var chunk: Bytes = read(connection: connection, maxBytes: 4096);
        if chunk.isEmpty() {
            panic(message: "connection closed before HTTP headers");
        }
        raw = raw.concat(other: chunk);
    }
    var text: str = raw.toUtf8().unwrap();
    var delimiter: Option<int> = text.indexOf(needle: "\r\n\r\n");
    var headEnd: int = delimiter.unwrap();
    if headEnd > 8192 {
        panic(message: "HTTP headers exceed 8 KiB");
    }
    var head: str = text.substring(start: 0, end: some(value: headEnd));
    var lines: List<str> = head.split(separator: "\r\n");
    var start: List<str> = lines[0].split(separator: " ");
    if start.length() != 3 || start[2] != "HTTP/1.1" {
        panic(message: "expected an HTTP/1.1 request line");
    }
    var mut headers: Map<str, str> = { };
    var mut i: int = 1;
    while i < lines.length() {
        var position: Option<int> = lines[i].indexOf(needle: ":");
        if position.isNone() {
            panic(message: "malformed HTTP header");
        }
        var colon: int = position.unwrap();
        var name: str = lines[i]
            .substring(start: 0, end: some(value: colon))
            .toLowerCase();
        var value: str = lines[i]
            .substring(start: colon + 1, end: none<int>())
            .trim();
        if headers.containsKey(key: name) {
            panic(message: "duplicate HTTP header");
        }
        headers.insert(key: name, value: value);
        i = i + 1;
    }
    if headers.containsKey(key: "transfer-encoding") {
        panic(message: "chunked requests are unsupported");
    }
    var mut contentLength: int = 0;
    if headers.containsKey(key: "content-length") {
        contentLength = decimal(
            text: headers.get(key: "content-length").unwrap(),
        );
    }
    while raw.length() - headEnd - 4 < contentLength {
        var chunk: Bytes = read(connection: connection, maxBytes: 4096);
        if chunk.isEmpty() {
            panic(message: "connection closed before HTTP body");
        }
        raw = raw.concat(other: chunk);
        if raw.length() > 1056768 {
            panic(message: "HTTP request exceeds size limit");
        }
    }
    if raw.length() - headEnd - 4 != contentLength {
        panic(message: "HTTP body length mismatch");
    }
    var body: str = raw
        .toUtf8()
        .unwrap()
        .substring(start: headEnd + 4, end: none<int>());
    return ServerRequest(
        method: start[0],
        target: start[1],
        version: start[2],
        headers: headers,
        body: body,
    );
};

fn sendResponse(
    connection: TcpConnectionHandle,
    response: ServerResponse,
) -> void {
    if response.status < 100 || response.status > 599 {
        panic(message: "invalid HTTP status");
    }
    if response.reason.contains(needle: "\r")
        || response.reason.contains(needle: "\n")
        || response.contentType.contains(needle: "\r")
        || response.contentType.contains(needle: "\n") {
        panic(message: "invalid HTTP response metadata");
    }
    var mut wire: str = "HTTP/1.1 ${response.status} ${response.reason}\r\n";
    wire = wire + "Content-Type: ${response.contentType}\r\n";
    wire = wire + "Content-Length: ${response.body.utf8ByteLength()}\r\n";
    wire = wire + "Connection: close\r\n";
    for name in response.headers.keys() {
        var lower: str = name.toLowerCase();
        if lower == "content-length"
            || lower == "connection"
            || lower == "content-type" {
            continue;
        }
        var value: str = response.headers.get(key: name).unwrap();
        if name.contains(needle: ":")
            || name.contains(needle: "\r")
            || name.contains(needle: "\n")
            || value.contains(needle: "\r")
            || value.contains(needle: "\n") {
            panic(message: "invalid HTTP response header");
        }
        wire = wire + "${name}: ${value}\r\n";
    }
    writeText(
        connection: connection,
        text: wire + "\r\n" + response.body,
    );
    return;
};

fn openListener(address: str) -> TcpListenerHandle {
    return listen(address: address);
};

fn openTlsListener(address: str, certPath: str, keyPath: str) -> TcpListenerHandle {
    return listenTls(address: address, certPath: certPath, keyPath: keyPath);
};

fn serveOne(
    listener: TcpListenerHandle,
    handler: fn(request: ServerRequest) -> ServerResponse,
) -> void {
    var connection: TcpConnectionHandle = accept(listener: listener);
    var request: ServerRequest = readRequest(connection: connection);
    var response: ServerResponse = handler(request: request);
    sendResponse(connection: connection, response: response);
    close(connection: connection);
    return;
};

fn serve(
    address: str,
    handler: fn(request: ServerRequest) -> ServerResponse,
) -> void {
    var listener: TcpListenerHandle = listen(address: address);
    loop {
        serveOne(listener: listener, handler: handler);
    }
};

fn serveTls(
    address: str,
    certPath: str,
    keyPath: str,
    handler: fn(request: ServerRequest) -> ServerResponse,
) -> void {
    var listener: TcpListenerHandle = listenTls(address: address, certPath: certPath, keyPath: keyPath);
    loop {
        serveOne(listener: listener, handler: handler);
    }
};
