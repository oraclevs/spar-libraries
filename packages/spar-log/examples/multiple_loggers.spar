import { Logger } from "../src/core/logger.spar";
import { LoggerConfig } from "../src/core/config.spar";

fn main() -> int {
    var root: Logger = Logger(name: "compiler", config: LoggerConfig());
    var mut compiler: Logger = root;
    var mut parser: Logger = root.named(name: "parser");
    var mut runtime: Logger = root.named(name: "runtime");
    compiler.info(message: "compilation started");
    parser.info(message: "parsed 12 files");
    runtime.warn(message: "slow start");
    return 0;
};
