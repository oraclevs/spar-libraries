import pkg { readText, removeFile, exists } from "std/fs";
import { Logger } from "../src/core/logger.spar";
import { LoggerConfig } from "../src/core/config.spar";
import { strField } from "../src/core/field.spar";
import { consoleSink, fileSink } from "../src/sink/sink.spar";

fn main() -> int {
    var path: str = "/tmp/spar_log_example.log";
    if exists(path: path) {
        removeFile(path: path);
    }
    // Console and file at once. The file is appended to, never truncated.
    var mut logger: Logger = Logger(
        name: "build",
        config: LoggerConfig(sinks: [consoleSink(), fileSink(path: path)]),
    );
    logger.info(message: "Build started");
    logger.warn(message: "Cache unavailable", fields: [strField(name: "dir", value: ".cache")]);
    println(value: "--- " + path);
    println(value: readText(path: path));
    return 0;
};
