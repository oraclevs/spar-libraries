// Severity levels. Ordering comes from levelRank, never from string compares.
export enum LogLevel {
    Trace,
    Debug,
    Info,
    Warn,
    Error,
    Fatal
};

fn levelRank(level: LogLevel) -> int {
    if level == LogLevel::Trace {
        return 0;
    } else if level == LogLevel::Debug {
        return 1;
    } else if level == LogLevel::Info {
        return 2;
    } else if level == LogLevel::Warn {
        return 3;
    } else if level == LogLevel::Error {
        return 4;
    }
    return 5;
};

// Lower-case name: "info".
fn levelName(level: LogLevel) -> str {
    if level == LogLevel::Trace {
        return "trace";
    } else if level == LogLevel::Debug {
        return "debug";
    } else if level == LogLevel::Info {
        return "info";
    } else if level == LogLevel::Warn {
        return "warn";
    } else if level == LogLevel::Error {
        return "error";
    }
    return "fatal";
};

// True when `level` is at least as severe as `minimum`.
fn levelAtLeast(level: LogLevel, minimum: LogLevel) -> bool {
    return levelRank(level: level) >= levelRank(level: minimum);
};
