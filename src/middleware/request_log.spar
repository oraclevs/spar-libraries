import pkg { nowMillis } from "std/time";
import pkg { Logger } from "log/core/logger";
import pkg { LogLevel } from "log/core/level";
import pkg { LoggerConfig } from "log/core/config";
import pkg { Sink, SinkKind } from "log/sink/sink";
import pkg { intField, strField } from "log/core/field";
import { Context } from "../http/context.spar";
import { Response } from "../http/response.spar";
import { methodName } from "../http/request.spar";
import { Middleware } from "./middleware.spar";

// Logs "GET /users/42 200 12ms" through spar-log after each request: info for
// status < 400, warn for 4xx, error for 5xx. The logger is the application's
// own (any sinks, level or formatter spar-log supports). Fields: method, path,
// status, ms.
fn requestLogger(logger: Logger) -> Middleware {
    var run = fn(ctx: Context, next: fn(Context) -> Response) -> Response {
        var started: int = nowMillis();
        var res: Response = next(arg0: ctx);
        var ms: int = nowMillis() - started;
        var method: str = methodName(method: ctx.method());
        var mut out: Logger = logger;
        var level: LogLevel = LogLevel::Info;
        if res.status >= 500 {
            level = LogLevel::Error;
        } else if res.status >= 400 {
            level = LogLevel::Warn;
        }
        out.log(
            level: level,
            message: method + " " + ctx.path() + " " + res.status.toString() + " " + ms.toString() + "ms",
            fields: [strField(name: "method", value: method), strField(name: "path", value: ctx.path()), intField(name: "status", value: res.status), intField(name: "ms", value: ms)],
        );
        return res;
    };
    return Middleware(name: "requestLogger", run: run);
};

// A logger that writes every level to stderr. Use it with serveStdio, where
// stdout carries the HTTP response and must stay clean.
fn stderrLogger(name: str = "web", level: LogLevel = LogLevel::Info) -> Logger {
    return Logger(name: name, config: LoggerConfig(level: level, sinks: [Sink(kind: SinkKind::Console, stderrFrom: LogLevel::Trace)]));
};
