import pkg { stringify } from "std/json";
import { stripLineBreaks } from "../internal/utils.spar";
import { WebError } from "../error/web_error.spar";

// A Set-Cookie value. Defaults are the safe ones: HttpOnly, SameSite=Lax.
// `secure` is off by default so plain-HTTP development works; turn it on in
// production. maxAge < 0 means "session cookie".
export struct Cookie {
    name: str = "";
    value: str = "";
    path: str = "/";
    domain: str = "";
    maxAge: int = -1;
    secure: bool = false;
    httpOnly: bool = true;
    sameSite: str = "Lax";
};

fn cookieText(text: str) -> str {
    return stripLineBreaks(value: text).replace(from: ";", to: "").replace(from: ",", to: "").replace(from: " ", to: "");
};

fn serializeCookie(cookie: Cookie) -> str {
    var mut out: str = cookieText(text: cookie.name) + "=" + cookieText(text: cookie.value);
    if !cookie.path.isEmpty() {
        out = out + "; Path=" + cookieText(text: cookie.path);
    }
    if !cookie.domain.isEmpty() {
        out = out + "; Domain=" + cookieText(text: cookie.domain);
    }
    if cookie.maxAge >= 0 {
        out = out + "; Max-Age=" + cookie.maxAge.toString();
    }
    var same: str = cookie.sameSite;
    var needsSecure: bool = same == "None";
    if cookie.secure || needsSecure {
        out = out + "; Secure";
    }
    if cookie.httpOnly {
        out = out + "; HttpOnly";
    }
    if same == "Strict" || same == "Lax" || same == "None" {
        out = out + "; SameSite=" + same;
    }
    return out;
};

// Status, headers and body. Header names are stored lower-case. A response
// built with Response.fail carries its WebError until the app's error boundary
// renders it.
export struct Response {
    status: int = 200;
    headers: Map<str, str> = {};
    cookies: List<str> = [];
    body: str = "";
    failed: bool = false;
    failure: WebError = WebError();
};

fn headerMap(name: str, value: str) -> Map<str, str> {
    var mut h: Map<str, str> = {};
    h.insert(key: name, value: value);
    return h;
};

impl Response {
    fn text(value: str, status: int = 200) -> Response {
        return Response(status: status, headers: headerMap(name: "content-type", value: "text/plain; charset=utf-8"), body: value);
    };

    fn html(value: str, status: int = 200) -> Response {
        return Response(status: status, headers: headerMap(name: "content-type", value: "text/html; charset=utf-8"), body: value);
    };

    // Serializes any value with the native JSON encoder.
    fn json(value: Any, status: int = 200) -> Response {
        return Response(status: status, headers: headerMap(name: "content-type", value: "application/json; charset=utf-8"), body: stringify(value: value));
    };

    // Raw JSON text, already serialized.
    fn jsonText(value: str, status: int = 200) -> Response {
        return Response(status: status, headers: headerMap(name: "content-type", value: "application/json; charset=utf-8"), body: value);
    };

    fn empty(status: int = 204) -> Response {
        return Response(status: status);
    };

    fn noContent() -> Response {
        return Response(status: 204);
    };

    // 301, 302, 303, 307 or 308. Other codes are a programming error (500).
    // The location is stripped of line breaks. For user-supplied targets also
    // check isLocalPath first to avoid open redirects.
    fn redirect(location: str, status: int = 302) -> Response {
        if status != 301 && status != 302 && status != 303 && status != 307 && status != 308 {
            return Response(status: 500, body: "Invalid redirect status");
        }
        return Response(status: status, headers: headerMap(name: "location", value: stripLineBreaks(value: location)));
    };

    // Carries an error to the app's error boundary, which renders it.
    fn fail(error: WebError) -> Response {
        return Response(status: error.status, failed: true, failure: error);
    };

    fn withStatus(self, code: int) -> Response {
        return Response(status: code, headers: self.headers, cookies: self.cookies, body: self.body, failed: self.failed, failure: self.failure);
    };

    fn withBody(self, value: str) -> Response {
        return Response(status: self.status, headers: self.headers, cookies: self.cookies, body: value, failed: self.failed, failure: self.failure);
    };

    // Sets (replaces) a header. CR, LF and NUL are removed from name and value
    // so a header can never be split.
    fn withHeader(self, name: str, value: str) -> Response {
        var mut h: Map<str, str> = self.headers;
        h.insert(key: stripLineBreaks(value: name).toLowerCase().trim(), value: stripLineBreaks(value: value));
        return Response(status: self.status, headers: h, cookies: self.cookies, body: self.body, failed: self.failed, failure: self.failure);
    };

    fn withCookie(self, cookie: Cookie) -> Response {
        var mut c: List<str> = self.cookies;
        c.append(value: serializeCookie(cookie: cookie));
        return Response(status: self.status, headers: self.headers, cookies: c, body: self.body, failed: self.failed, failure: self.failure);
    };

    // Expires a cookie in the client.
    fn clearCookie(self, name: str, path: str = "/") -> Response {
        return self.withCookie(cookie: Cookie(name: name, value: "", path: path, maxAge: 0));
    };

    fn header(self, name: str) -> str {
        return self.headers.getOr(key: name.toLowerCase(), fallback: "");
    };
};

// A same-site absolute path such as "/dashboard". Rejects "//host", "/\\host",
// full URLs and anything with a line break.
fn isLocalPath(location: str) -> bool {
    if !location.startsWith(prefix: "/") || location.startsWith(prefix: "//") || location.startsWith(prefix: "/\\") {
        return false;
    }
    return stripLineBreaks(value: location) == location;
};
