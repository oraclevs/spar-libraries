import { TestSuite } from "../core/suite.spar";
import { RunOptions } from "../core/options.spar";
import { SuiteResult } from "../result/suite_result.spar";
import { RunResult } from "../result/run_result.spar";

// The reporter boundary. The runner only produces results and calls these
// hooks; a JSON, TAP or JUnit reporter is another Reporter value.
// (Spar function types name their parameters arg0, arg1, ...)
//   onSuite  after each suite finished
//   onRun    once, after every suite finished
//   onList   instead of running, when options.list is set
fn ignoreSuite(result: SuiteResult, options: RunOptions) -> void {
    return;
};

fn ignoreRun(result: RunResult, options: RunOptions) -> void {
    return;
};

fn ignoreList(suites: List<TestSuite>, options: RunOptions) -> void {
    return;
};

export struct Reporter {
    name: str = "silent";
    onSuite: fn(SuiteResult, RunOptions) -> void = ignoreSuite;
    onRun: fn(RunResult, RunOptions) -> void = ignoreRun;
    onList: fn(List<TestSuite>, RunOptions) -> void = ignoreList;
};
