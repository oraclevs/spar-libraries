import pkg { print } from "std/io";
import pkg { readAll } from "std/io";
import { Request, parseRequest } from "../http/request.spar";
import { Response } from "../http/response.spar";
import { statusBadRequest, reasonPhrase } from "../http/status.spar";
import { WebError, badRequest } from "../error/web_error.spar";
import { Server } from "../app/app.spar";
import { indexIn, cr, crlf } from "../internal/utils.spar";

// One HTTP/1.1 request on stdin, one response on stdout. This is the only
// transport SPAR can offer today (no native listener): put a TCP front end in
// front of it (see tools/bridge.sh). Request bodies are taken as everything
// after the blank line; the front end is expected to have read Content-Length
// bytes and closed stdin.

fn parseHeaderLines(lines: List<str>) -> Map<str, str> {
    var mut headers: Map<str, str> = {};
    for line in lines {
        var cut: int = indexIn(table: line, needle: ":");
        if cut > 0 {
            var name: str = line.substring(start: 0, end: some<int>(value: cut)).trim().toLowerCase();
            var val: str = line.substring(start: cut + 1, end: none<int>()).trim();
            var prior: str = headers.getOr(key: name, fallback: "");
            if prior.isEmpty() {
                headers.insert(key: name, value: val);
            } else {
                headers.insert(key: name, value: prior + ", " + val);
            }
        }
    }
    return headers;
};

// Parses raw HTTP text into a Request. Malformed input is a 400 (501 for
// unknown methods), never an exception.
fn parseHttpRequest(raw: str, remote: str = "") -> Result<Request, WebError> {
    var mut blank: str = crlf() + crlf();
    var mut sepLen: int = 4;
    var mut split: Option<int> = raw.indexOf(needle: blank);
    if split.isNone() {
        blank = "\n\n";
        sepLen = 2;
        split = raw.indexOf(needle: blank);
    }
    var mut head: str = raw;
    var mut body: str = "";
    if split.isSome() {
        head = raw.substring(start: 0, end: some<int>(value: split.unwrap()));
        body = raw.substring(start: split.unwrap() + sepLen, end: none<int>());
    }
    var lines: List<str> = head.replace(from: cr(), to: "").split(separator: "\n");
    var parts: List<str> = lines[0].split(separator: " ");
    if parts.length() != 3 || !parts[2].startsWith(prefix: "HTTP/1.") {
        return err<Request, WebError>(error: badRequest(message: "Malformed request line"));
    }
    var headers: Map<str, str> = parseHeaderLines(lines: lines.skip(count: 1));
    return parseRequest(method: parts[0], target: parts[1], headers: headers, body: body, remote: remote);
};

// Status line, headers, blank line, body. Every response closes the
// connection; the TCP front end supplies Content-Length.
fn serializeResponse(response: Response) -> str {
    var mut out: str = "HTTP/1.1 " + response.status.toString() + " " + reasonPhrase(code: response.status) + crlf();
    for entry in response.headers.entries() {
        out = out + entry.key + ": " + entry.value + crlf();
    }
    for cookie in response.cookies {
        out = out + "set-cookie: " + cookie + crlf();
    }
    out = out + "connection: close" + crlf() + crlf();
    return out + response.body;
};

// Reads stdin to EOF, handles one request, writes the response. Returns 0.
fn serveStdio(server: Server) -> int {
    var parsed: Result<Request, WebError> = parseHttpRequest(raw: readAll());
    var mut response: Response = Response.text(value: "Bad Request", status: statusBadRequest);
    if parsed.isOk() {
        response = server.handle(request: parsed.unwrap());
    } else {
        response = Response.text(value: parsed.unwrapErr().message, status: parsed.unwrapErr().status);
    }
    print(value: serializeResponse(response: response));
    return 0;
};
