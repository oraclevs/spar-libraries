import { ArgMatch } from "./match.spar";
import { toInt, toFloat, toBool } from "../internal/value.spar";

// The result of a successful parse. Every option, flag and positional of the
// selected command appears in `args` (with its default when it was not given).
export struct Matches {
    args: Map<str, ArgMatch> = { };
    path: List<str> = [];
    unknown: List<str> = [];
    warnings: List<str> = [];
};

impl Matches {
    fn has(self, name: str) -> bool {
        // True when a value exists, from the command line or a default.
        var found: Option<ArgMatch> = self.args.get(key: name);
        if found.isNone() {
            return false;
        }
        return found.unwrap().values.length() > 0
            || found.unwrap().occurrences > 0;
    };
    fn given(self, name: str) -> bool {
        // True only when the user typed the argument.
        var found: Option<ArgMatch> = self.args.get(key: name);
        if found.isNone() {
            return false;
        }
        return found.unwrap().explicit;
    };
    fn count(self, name: str) -> int {
        var found: Option<ArgMatch> = self.args.get(key: name);
        if found.isNone() {
            return 0;
        }
        return found.unwrap().occurrences;
    };
    fn getList(self, name: str) -> List<str> {
        var found: Option<ArgMatch> = self.args.get(key: name);
        if found.isNone() {
            return [];
        }
        return found.unwrap().values;
    };
    fn getStr(self, name: str) -> Option<str> {
        // The last value, so a repeated option reads as "last one wins".
        var values: List<str> = self.getList(name: name);
        if values.length() == 0 {
            return none();
        }
        return some(value: values[values.length() - 1]);
    };
    fn getInt(self, name: str) -> Option<int> {
        var text: Option<str> = self.getStr(name: name);
        if text.isNone() {
            return none();
        }
        return toInt(text: text.unwrap());
    };
    fn getFloat(self, name: str) -> Option<float> {
        var text: Option<str> = self.getStr(name: name);
        if text.isNone() {
            return none();
        }
        return toFloat(text: text.unwrap());
    };
    fn getBool(self, name: str) -> Option<bool> {
        var text: Option<str> = self.getStr(name: name);
        if text.isNone() {
            return none();
        }
        return toBool(text: text.unwrap());
    };
    fn getInts(self, name: str) -> List<int> {
        var mut out: List<int> = [];
        for text in self.getList(name: name) {
            var parsed: Option<int> = toInt(text: text);
            if parsed.isSome() {
                out.append(value: parsed.unwrap());
            }
        }
        return out;
    };
    fn getFloats(self, name: str) -> List<float> {
        var mut out: List<float> = [];
        for text in self.getList(name: name) {
            var parsed: Option<float> = toFloat(text: text);
            if parsed.isSome() {
                out.append(value: parsed.unwrap());
            }
        }
        return out;
    };
    fn flag(self, name: str) -> bool {
        // A flag's boolean state (false when the flag is unknown).
        var value: Option<bool> = self.getBool(name: name);
        return value.unwrapOr(fallback: false);
    };
    fn commandPath(self) -> List<str> {
        // The selected subcommand's full path, e.g. ["package", "add"]; empty at
        // the top level.
        return self.path;
    };
    fn command(self) -> str {
        // The selected subcommand's own name, or "" at the top level.
        if self.path.length() == 0 {
            return "";
        }
        return self.path[self.path.length() - 1];
    };
};
