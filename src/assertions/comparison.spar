import { Failure } from "../result/failure.spar";
import { intValue, floatValue, strValue } from "../result/value.spar";
import { failNow } from "../core/context.spar";

// `expected` in these failures is the bound the actual value is compared
// against; the assertion name says which relation was required.

fn assertGreater(actual: int, bound: int, message: str = "") -> void {
    if !(actual > bound) {
        failNow(failure: Failure(assertion: "assertGreater", message: message, expected: intValue(value: bound), actual: intValue(value: actual)));
    }
    return;
};

fn assertGreaterOrEqual(actual: int, bound: int, message: str = "") -> void {
    if !(actual >= bound) {
        failNow(failure: Failure(assertion: "assertGreaterOrEqual", message: message, expected: intValue(value: bound), actual: intValue(value: actual)));
    }
    return;
};

fn assertLess(actual: int, bound: int, message: str = "") -> void {
    if !(actual < bound) {
        failNow(failure: Failure(assertion: "assertLess", message: message, expected: intValue(value: bound), actual: intValue(value: actual)));
    }
    return;
};

fn assertLessOrEqual(actual: int, bound: int, message: str = "") -> void {
    if !(actual <= bound) {
        failNow(failure: Failure(assertion: "assertLessOrEqual", message: message, expected: intValue(value: bound), actual: intValue(value: actual)));
    }
    return;
};

fn assertGreaterFloat(actual: float, bound: float, message: str = "") -> void {
    if !(actual > bound) {
        failNow(failure: Failure(assertion: "assertGreaterFloat", message: message, expected: floatValue(value: bound), actual: floatValue(value: actual)));
    }
    return;
};

fn assertGreaterOrEqualFloat(actual: float, bound: float, message: str = "") -> void {
    if !(actual >= bound) {
        failNow(failure: Failure(assertion: "assertGreaterOrEqualFloat", message: message, expected: floatValue(value: bound), actual: floatValue(value: actual)));
    }
    return;
};

fn assertLessFloat(actual: float, bound: float, message: str = "") -> void {
    if !(actual < bound) {
        failNow(failure: Failure(assertion: "assertLessFloat", message: message, expected: floatValue(value: bound), actual: floatValue(value: actual)));
    }
    return;
};

fn assertLessOrEqualFloat(actual: float, bound: float, message: str = "") -> void {
    if !(actual <= bound) {
        failNow(failure: Failure(assertion: "assertLessOrEqualFloat", message: message, expected: floatValue(value: bound), actual: floatValue(value: actual)));
    }
    return;
};
