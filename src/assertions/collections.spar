import { Failure } from "../result/failure.spar";
import {
    intValue,
    strValue,
    intListValue,
    strListValue
} from "../result/value.spar";
import { failNow } from "../core/context.spar";

// Lists are typed (`List<int>`, `List<str>`), so the element type is in the name.

fn assertContains(items: List<int>, item: int, message: str = "") -> void {
    if !items.contains(value: item) {
        failNow(failure: Failure(assertion: "assertContains", message: message, expected: intValue(value: item), actual: intListValue(value: items)));
    }
    return;
};

fn assertNotContains(items: List<int>, item: int, message: str = "") -> void {
    if items.contains(value: item) {
        failNow(failure: Failure(assertion: "assertNotContains", message: message, expected: intValue(value: item), actual: intListValue(value: items)));
    }
    return;
};

fn assertContainsStr(items: List<str>, item: str, message: str = "") -> void {
    if !items.contains(value: item) {
        failNow(failure: Failure(assertion: "assertContainsStr", message: message, expected: strValue(value: item), actual: strListValue(value: items)));
    }
    return;
};

fn assertNotContainsStr(items: List<str>, item: str, message: str = "") -> void {
    if items.contains(value: item) {
        failNow(failure: Failure(assertion: "assertNotContainsStr", message: message, expected: strValue(value: item), actual: strListValue(value: items)));
    }
    return;
};

fn assertEmpty(items: List<int>, message: str = "") -> void {
    if items.length() != 0 {
        failNow(failure: Failure(assertion: "assertEmpty", message: message, expected: intValue(value: 0), actual: intValue(value: items.length())));
    }
    return;
};

fn assertNotEmpty(items: List<int>, message: str = "") -> void {
    if items.length() == 0 {
        failNow(failure: Failure(assertion: "assertNotEmpty", message: message, actual: intListValue(value: items)));
    }
    return;
};

fn assertEmptyStr(items: List<str>, message: str = "") -> void {
    if items.length() != 0 {
        failNow(failure: Failure(assertion: "assertEmptyStr", message: message, expected: intValue(value: 0), actual: intValue(value: items.length())));
    }
    return;
};

fn assertNotEmptyStr(items: List<str>, message: str = "") -> void {
    if items.length() == 0 {
        failNow(failure: Failure(assertion: "assertNotEmptyStr", message: message, actual: strListValue(value: items)));
    }
    return;
};

// Works on any list type; only the length is reported.
fn assertLength<T>(items: List<T>, expected: int, message: str = "") -> void {
    if items.length() != expected {
        failNow(failure: Failure(assertion: "assertLength", message: message, expected: intValue(value: expected), actual: intValue(value: items.length())));
    }
    return;
};
