import { Failure } from "../result/failure.spar";
import { failNow } from "../core/context.spar";

// Passes when `body` stops with a recoverable runtime error (division by zero,
// unwrapping none or an Err, out-of-range list access, ...).
//
// Limitation: Spar's `panic` and a failing spar-test assertion inside `body`
// cannot be told apart from other errors here, and `panic` itself cannot be
// recovered at all, so `assertFails` on code that panics ends the whole run.
// A real `catch` for panics in Spar would remove this restriction.
fn assertFails(body: fn() -> void, message: str = "") -> void {
    var mut raised: bool = false;
    try {
        body();
    } catch problem {
        raised = true;
    }
    if !raised {
        failNow(failure: Failure(
            assertion: "assertFails",
            message: "expected the function to fail, but it completed. " + message,
        ));
    }
    return;
};
