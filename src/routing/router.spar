import { Context } from "../http/context.spar";
import { Response } from "../http/response.spar";
import { HttpMethod, methodName } from "../http/request.spar";
import { WebError, configError } from "../error/web_error.spar";
import { Middleware, composeChain } from "../middleware/middleware.spar";
import { Route, RouteGroup, noHandler } from "./route.spar";
import { pathSegments, canonicalPath, percentDecode, join, indexIn } from "../internal/utils.spar";

// segment kinds
const kindStatic: int = 0;
const kindParam: int = 1;
const kindWildcard: int = 2;

// A route after normalisation: path split once, group/route middleware already
// folded around the handler.
export struct CompiledRoute {
    method: HttpMethod = HttpMethod::Get;
    pattern: str = "/";
    shape: str = "/";
    segments: List<str> = [];
    kinds: List<int> = [];
    names: List<str> = [];
    handler: fn(Context) -> Response = noHandler;
};

// found:        route is the CompiledRoute index, params filled
// notFound:     no route has this path
// notAllowed:   path exists for other methods; `allow` lists them
export enum MatchKind {
    Found,
    NotFound,
    NotAllowed
};

export struct Match {
    kind: MatchKind = MatchKind::NotFound;
    route: CompiledRoute = CompiledRoute();
    params: Map<str, str> = {};
    allow: List<str> = [];
};

// Static routes live in `exact` (key "METHOD /path") for O(1) lookup.
// Routes with parameters are kept in `patterns`, sorted by specificity:
// at the first differing segment static < ":param" < "*wildcard". Registration
// order never decides a match. Trailing and repeated slashes are ignored.
export struct Router {
    exact: Map<str, CompiledRoute> = {};
    exactMethods: Map<str, List<str>> = {};
    patterns: List<CompiledRoute> = [];
};

struct Flat {
    method: HttpMethod = HttpMethod::Get;
    path: str = "/";
    chain: List<Middleware> = [];
    handler: fn(Context) -> Response = noHandler;
};

fn joinPaths(prefix: str, path: str) -> str {
    return canonicalPath(path: prefix + "/" + path);
};

fn flattenGroup(group: RouteGroup, prefix: str, inherited: List<Middleware>, out: List<Flat>) -> List<Flat> {
    var mut result: List<Flat> = out;
    var base: str = joinPaths(prefix: prefix, path: group.prefix);
    var mut layers: List<Middleware> = inherited;
    layers.appendAll(values: group.middleware);
    for route in group.routes {
        var mut chain: List<Middleware> = layers;
        chain.appendAll(values: route.middleware);
        result.append(value: Flat(method: route.method, path: joinPaths(prefix: base, path: route.path), chain: chain, handler: route.handler));
    }
    for child in group.groups {
        result = flattenGroup(group: child, prefix: base, inherited: layers, out: result);
    }
    return result;
};

fn compileOne(flat: Flat) -> Result<CompiledRoute, WebError> {
    var segs: List<str> = pathSegments(path: flat.path);
    var mut segments: List<str> = [];
    var mut kinds: List<int> = [];
    var mut names: List<str> = [];
    var mut shape: List<str> = [];
    var label: str = methodName(method: flat.method) + " " + flat.path;
    var mut i: int = 0;
    while i < segs.length() {
        var s: str = segs[i];
        if s.startsWith(prefix: ":") {
            var name: str = s.substring(start: 1, end: none<int>());
            if name.isEmpty() {
                return err<CompiledRoute, WebError>(error: configError(message: "empty parameter name in " + label));
            }
            if names.contains(value: name) {
                return err<CompiledRoute, WebError>(error: configError(message: "duplicate parameter '" + name + "' in " + label));
            }
            segments.append(value: s);
            kinds.append(value: kindParam);
            names.append(value: name);
            shape.append(value: ":");
        } else if s.startsWith(prefix: "*") {
            var name: str = s.substring(start: 1, end: none<int>());
            if name.isEmpty() || i != segs.length() - 1 {
                return err<CompiledRoute, WebError>(error: configError(message: "wildcard must be named and last in " + label));
            }
            if names.contains(value: name) {
                return err<CompiledRoute, WebError>(error: configError(message: "duplicate parameter '" + name + "' in " + label));
            }
            segments.append(value: s);
            kinds.append(value: kindWildcard);
            names.append(value: name);
            shape.append(value: "*");
        } else {
            segments.append(value: s);
            kinds.append(value: kindStatic);
            names.append(value: "");
            shape.append(value: s);
        }
        i = i + 1;
    }
    var composed: fn(Context) -> Response = composeChain(layers: flat.chain, inner: flat.handler);
    return ok<CompiledRoute, WebError>(value: CompiledRoute(
        method: flat.method,
        pattern: flat.path,
        shape: "/" + join(values: shape, separator: "/"),
        segments: segments,
        kinds: kinds,
        names: names,
        handler: composed,
    ));
};

// true when `a` must be tried before `b`
fn moreSpecific(a: CompiledRoute, b: CompiledRoute) -> bool {
    var mut i: int = 0;
    while i < a.kinds.length() && i < b.kinds.length() {
        if a.kinds[i] != b.kinds[i] {
            return a.kinds[i] < b.kinds[i];
        }
        i = i + 1;
    }
    return a.kinds.length() < b.kinds.length();
};

fn insertSorted(sorted: List<CompiledRoute>, route: CompiledRoute) -> List<CompiledRoute> {
    var mut out: List<CompiledRoute> = sorted;
    var mut at: int = out.length();
    var mut i: int = 0;
    while i < out.length() {
        if moreSpecific(a: route, b: out[i]) {
            at = i;
            break;
        }
        i = i + 1;
    }
    out.insert(index: at, value: route);
    return out;
};

// Normalises routes and groups once. Fails (listing every problem) on
// invalid paths and on duplicate method + shape, e.g. "GET /u/:id" twice or
// "GET /u/:id" with "GET /u/:name".
fn buildRouter(routes: List<Route>, groups: List<RouteGroup>) -> Result<Router, WebError> {
    var mut flats: List<Flat> = [];
    for route in routes {
        flats.append(value: Flat(method: route.method, path: canonicalPath(path: route.path), chain: route.middleware, handler: route.handler));
    }
    for group in groups {
        flats = flattenGroup(group: group, prefix: "", inherited: [], out: flats);
    }
    var mut router: Router = Router();
    var mut problems: List<str> = [];
    var mut seen: Map<str, bool> = {};
    for flat in flats {
        var compiled: Result<CompiledRoute, WebError> = compileOne(flat: flat);
        if compiled.isErr() {
            problems.append(value: compiled.unwrapErr().message);
            continue;
        }
        var route: CompiledRoute = compiled.unwrap();
        var key: str = methodName(method: route.method) + " " + route.shape;
        if seen.containsKey(key: key) {
            problems.append(value: "duplicate route " + key);
            continue;
        }
        seen.insert(key: key, value: true);
        var isStatic: bool = !route.kinds.contains(value: kindParam) && !route.kinds.contains(value: kindWildcard);
        if isStatic {
            router.exact.insert(key: key, value: route);
            var mut methods: List<str> = router.exactMethods.getOr(key: route.shape, fallback: []);
            methods.append(value: methodName(method: route.method));
            router.exactMethods.insert(key: route.shape, value: methods);
        } else {
            router.patterns = insertSorted(sorted: router.patterns, route: route);
        }
    }
    if problems.length() > 0 {
        return err<Router, WebError>(error: configError(message: join(values: problems, separator: "; ")));
    }
    return ok<Router, WebError>(value: router);
};

// Params of `route` for `segs`, or none when the path does not fit.
fn matchSegments(route: CompiledRoute, segs: List<str>) -> Option<Map<str, str>> {
    var n: int = route.kinds.length();
    var hasWildcard: bool = n > 0 && route.kinds[n - 1] == kindWildcard;
    if hasWildcard {
        if segs.length() < n {
            return none<Map<str, str>>();
        }
    } else if segs.length() != n {
        return none<Map<str, str>>();
    }
    var mut params: Map<str, str> = {};
    var mut i: int = 0;
    while i < n {
        var kind: int = route.kinds[i];
        if kind == kindStatic {
            if segs[i] != route.segments[i] {
                return none<Map<str, str>>();
            }
        } else if kind == kindParam {
            params.insert(key: route.names[i], value: percentDecode(value: segs[i], plusAsSpace: false));
        } else {
            var rest: List<str> = segs.skip(count: i);
            params.insert(key: route.names[i], value: percentDecode(value: join(values: rest, separator: "/"), plusAsSpace: false));
        }
        i = i + 1;
    }
    return some<Map<str, str>>(value: params);
};

fn addUnique(list: List<str>, value: str) -> List<str> {
    var mut out: List<str> = list;
    if !out.contains(value: value) {
        out.append(value: value);
    }
    return out;
};

// Finds the route for a method and path. HEAD falls back to GET.
fn matchRoute(router: Router, method: HttpMethod, path: str) -> Match {
    var segs: List<str> = pathSegments(path: path);
    var canon: str = canonicalPath(path: path);
    var mut names: List<str> = [methodName(method: method)];
    if method == HttpMethod::Head {
        names.append(value: "GET");
    }
    for name in names {
        var hit: Option<CompiledRoute> = router.exact.get(key: name + " " + canon);
        if hit.isSome() {
            return Match(kind: MatchKind::Found, route: hit.unwrap());
        }
        for route in router.patterns {
            if methodName(method: route.method) == name {
                var params: Option<Map<str, str>> = matchSegments(route: route, segs: segs);
                if params.isSome() {
                    return Match(kind: MatchKind::Found, route: route, params: params.unwrap());
                }
            }
        }
    }
    var mut allow: List<str> = router.exactMethods.getOr(key: canon, fallback: []);
    for route in router.patterns {
        if matchSegments(route: route, segs: segs).isSome() {
            allow = addUnique(list: allow, value: methodName(method: route.method));
        }
    }
    if allow.contains(value: "GET") {
        allow = addUnique(list: allow, value: "HEAD");
    }
    if allow.length() == 0 {
        return Match(kind: MatchKind::NotFound);
    }
    return Match(kind: MatchKind::NotAllowed, allow: allow);
};
