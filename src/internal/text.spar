// Small string helpers. Spar strings have no indexing, padding or repeat, so
// these are built on substring().
fn slice(text: str, start: int, stop: int) -> str {
    return text.substring(start: start, end: some(value: stop));
};

fn charAt(text: str, index: int) -> str {
    return text.substring(start: index, end: some(value: index + 1));
};

fn dropPrefix(text: str, count: int) -> str {
    return text.substring(start: count, end: some(value: text.length()));
};

fn repeat(text: str, count: int) -> str {
    var mut out: str = "";
    var mut i: int = 0;
    while i < count {
        out = out + text;
        i = i + 1;
    }
    return out;
};

fn padRight(text: str, width: int) -> str {
    var missing: int = width - text.length();
    if missing <= 0 {
        return text;
    }
    return text + repeat(text: " ", count: missing);
};

fn fold(text: str, caseSensitive: bool) -> str {
    if caseSensitive {
        return text;
    }
    return text.lower();
};

fn sameText(left: str, right: str, caseSensitive: bool) -> bool {
    return fold(text: left, caseSensitive: caseSensitive) == fold(
        text: right,
        caseSensitive: caseSensitive,
    );
};

fn listContains(items: List<str>, wanted: str, caseSensitive: bool) -> bool {
    for item in items {
        if sameText(left: item, right: wanted, caseSensitive: caseSensitive) {
            return true;
        }
    }
    return false;
};

fn sameList(left: List<str>, right: List<str>) -> bool {
    if left.length() != right.length() {
        return false;
    }
    var mut i: int = 0;
    while i < left.length() {
        if left[i] != right[i] {
            return false;
        }
        i = i + 1;
    }
    return true;
};

fn isDigit(ch: str) -> bool {
    return "0123456789".contains(needle: ch);
};

// True for text like -5, -0.25 or -.5, which should read as a value and not
// as a short option.
fn looksNegativeNumber(text: str) -> bool {
    if text.length() < 2 || charAt(text: text, index: 0) != "-" {
        return false;
    }
    var mut seenDigit: bool = false;
    var mut seenDot: bool = false;
    var mut i: int = 1;
    while i < text.length() {
        var ch: str = charAt(text: text, index: i);
        if isDigit(ch: ch) {
            seenDigit = true;
        } else if ch == "." && !seenDot {
            seenDot = true;
        } else {
            return false;
        }
        i = i + 1;
    }
    return seenDigit;
};

// Edit distance, used for "did you mean" suggestions.
fn distance(left: str, right: str) -> int {
    var n: int = left.length();
    var m: int = right.length();
    if n == 0 {
        return m;
    }
    if m == 0 {
        return n;
    }
    var mut previous: List<int> = [];
    var mut j: int = 0;
    while j <= m {
        previous.append(value: j);
        j = j + 1;
    }
    var mut i: int = 1;
    while i <= n {
        var mut current: List<int> = [i];
        var a: str = charAt(text: left, index: i - 1);
        var mut k: int = 1;
        while k <= m {
            var b: str = charAt(text: right, index: k - 1);
            var mut cost: int = 1;
            if a == b {
                cost = 0;
            }
            var deletion: int = previous[k] + 1;
            var insertion: int = current[k - 1] + 1;
            var substitution: int = previous[k - 1] + cost;
            var mut best: int = deletion;
            if insertion < best {
                best = insertion;
            }
            if substitution < best {
                best = substitution;
            }
            current.append(value: best);
            k = k + 1;
        }
        previous = current;
        i = i + 1;
    }
    return previous[m];
};

// The candidate closest to `name`, or "" when nothing is close enough.
fn closest(name: str, candidates: List<str>) -> str {
    var mut bestName: str = "";
    var mut bestScore: int = 3;
    for candidate in candidates {
        var score: int = distance(
            left: name.lower(),
            right: candidate.lower(),
        );
        if score < bestScore {
            bestScore = score;
            bestName = candidate;
        }
    }
    return bestName;
};
