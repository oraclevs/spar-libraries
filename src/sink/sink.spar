import { LogLevel } from "../core/level.spar";
import pkg { isStdoutTty, isStderrTty } from "std/terminal";
import { Formatter, prettyFormatter } from "../format/formatter.spar";

export enum SinkKind {
    Console,
    File,
    Memory,
    Custom
};

fn discard(text: str) -> void {
    return;
};

/// Where formatted text goes. Each sink owns its formatter and minimum level.
///   Console: stdout, or stderr for levels >= stderrFrom
///   File:    appends one line per record to `path`
///   Memory:  collected inside the Logger (see Logger.lines / Logger.records)
///   Custom:  calls `write` with the formatted line
export struct Sink {
    kind: SinkKind = SinkKind::Console;
    formatter: Formatter = prettyFormatter();
    minLevel: LogLevel = LogLevel::Trace;
    stderrFrom: LogLevel = LogLevel::Warn;
    path: str = "";
    write: fn(str) -> void = discard;
};

// Colored when attached to a terminal, plain when piped to a file or program.
fn consoleSink() -> Sink {
    return Sink(kind: SinkKind::Console, formatter: Formatter(color: isStdoutTty() && isStderrTty()));
};

// Always colored, even when not a terminal.
fn coloredConsoleSink() -> Sink {
    return Sink(kind: SinkKind::Console, formatter: Formatter(color: true));
};

fn fileSink(path: str) -> Sink {
    return Sink(kind: SinkKind::File, path: path);
};

fn memorySink() -> Sink {
    return Sink(kind: SinkKind::Memory);
};

fn customSink(write: fn(str) -> void) -> Sink {
    return Sink(kind: SinkKind::Custom, write: write);
};
