import pkg { nowMillis, elapsedMillis } from "std/time";
import { Test } from "./test.spar";
import { TestSuite } from "./suite.spar";
import { RunOptions } from "./options.spar";
import { selectSuites } from "./filter.spar";
import { failureFrom } from "./context.spar";
import { Failure } from "../result/failure.spar";
import { TestResult, TestStatus } from "../result/test_result.spar";
import { SuiteResult, addTestResult } from "../result/suite_result.spar";
import { RunResult, addSuiteResult, isSuccess } from "../result/run_result.spar";
import { Reporter } from "../reporter/reporter.spar";

// Runs `body` and returns what went wrong, as at most one Failure: an
// assertion stops its test at the first failure, and any other runtime error
// that try/catch can recover (division by zero, unwrapping none, ...) becomes
// an "error" failure. `panic` cannot be recovered and ends the whole process.
fn guarded(body: fn() -> void, label: str) -> List<Failure> {
    var mut failures: List<Failure> = [];
    try {
        body();
    } catch problem {
        failures.append(value: failureFrom(caught: problem.message, label: label));
    }
    return failures;
};

fn named(failures: List<Failure>, testName: str) -> List<Failure> {
    var mut out: List<Failure> = [];
    for failure in failures {
        var mut copy: Failure = failure;
        copy.testName = testName;
        out.append(value: copy);
    }
    return out;
};

fn joinFailures(left: List<Failure>, right: List<Failure>) -> List<Failure> {
    var mut out: List<Failure> = left;
    for failure in right {
        out.append(value: failure);
    }
    return out;
};

fn runTest(suite: TestSuite, test: Test) -> TestResult {
    if !test.enabled {
        return TestResult(name: test.name, status: TestStatus::Skipped);
    }
    var start: int = nowMillis();
    var before: fn() -> void = suite.beforeEach;
    var after: fn() -> void = suite.afterEach;
    var body: fn() -> void = test.run;
    var mut failures: List<Failure> = named(
        failures: guarded(body: before, label: "beforeEach"),
        testName: test.name,
    );
    if failures.length() == 0 {
        failures = named(
            failures: guarded(body: body, label: test.name),
            testName: test.name,
        );
    }
    var cleanup: List<Failure> = named(
        failures: guarded(body: after, label: "afterEach"),
        testName: test.name,
    );
    failures = joinFailures(left: failures, right: cleanup);
    var mut status: TestStatus = TestStatus::Passed;
    if failures.length() > 0 {
        status = TestStatus::Failed;
    }
    return TestResult(
        name: test.name,
        status: status,
        duration: elapsedMillis(startMillis: start),
        failures: failures,
    );
};

fn runSuite(suite: TestSuite, options: RunOptions) -> SuiteResult {
    var start: int = nowMillis();
    var mut result: SuiteResult = SuiteResult(name: suite.name);
    var beforeAll: fn() -> void = suite.beforeAll;
    var afterAll: fn() -> void = suite.afterAll;
    var setup: List<Failure> = named(
        failures: guarded(body: beforeAll, label: "beforeAll"),
        testName: "${suite.name} (beforeAll)",
    );
    if setup.length() > 0 {
        // Setup failed: nothing in this suite can be trusted, so skip it all.
        result.hookFailures = setup;
        for test in suite.tests {
            result = addTestResult(
                suite: result,
                result: TestResult(name: test.name, status: TestStatus::Skipped),
            );
        }
    } else {
        for test in suite.tests {
            var testResult: TestResult = runTest(suite: suite, test: test);
            result = addTestResult(suite: result, result: testResult);
            if options.failFast && testResult.status == TestStatus::Failed {
                break;
            }
        }
    }
    var teardown: List<Failure> = named(
        failures: guarded(body: afterAll, label: "afterAll"),
        testName: "${suite.name} (afterAll)",
    );
    result.hookFailures = joinFailures(left: result.hookFailures, right: teardown);
    result.duration = elapsedMillis(startMillis: start);
    return result;
};

// The one orchestration entry point: filters, runs, times, collects results and
// tells the reporter. List mode reports the selection and runs nothing.
fn runSuites(suites: List<TestSuite>, options: RunOptions, reporter: Reporter) -> RunResult {
    var selected: List<TestSuite> = selectSuites(suites: suites, filter: options.filter);
    if options.list {
        var listing: fn(List<TestSuite>, RunOptions) -> void = reporter.onList;
        listing(arg0: selected, arg1: options);
        return RunResult();
    }
    var start: int = nowMillis();
    var onSuite: fn(SuiteResult, RunOptions) -> void = reporter.onSuite;
    var onRun: fn(RunResult, RunOptions) -> void = reporter.onRun;
    var mut run: RunResult = RunResult();
    for suite in selected {
        var suiteResult: SuiteResult = runSuite(suite: suite, options: options);
        run = addSuiteResult(run: run, suite: suiteResult);
        onSuite(arg0: suiteResult, arg1: options);
        if options.failFast && !isSuccess(run: run) {
            break;
        }
    }
    run.duration = elapsedMillis(startMillis: start);
    onRun(arg0: run, arg1: options);
    return run;
};
