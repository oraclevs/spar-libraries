// A named value attached to a log record. The value keeps its type through
// `kind`, so the structured formatter can write numbers and booleans unquoted.
// Use the strField / intField / floatField / boolField helpers.
export enum LogFieldKind {
    Text,
    Integer,
    Decimal,
    Flag
};

export struct LogField {
    name: str;
    value: str = "";
    kind: LogFieldKind = LogFieldKind::Text;
};

fn strField(name: str, value: str) -> LogField {
    return LogField(name: name, value: value, kind: LogFieldKind::Text);
};

fn intField(name: str, value: int) -> LogField {
    return LogField(name: name, value: "${value}", kind: LogFieldKind::Integer);
};

fn floatField(name: str, value: float) -> LogField {
    return LogField(name: name, value: "${value}", kind: LogFieldKind::Decimal);
};

fn boolField(name: str, value: bool) -> LogField {
    return LogField(name: name, value: "${value}", kind: LogFieldKind::Flag);
};
