import { ArgOption } from "./option.spar";
import { Flag } from "./flag.spar";
import { Positional } from "./positional.spar";
import { ArgGroup } from "./group.spar";
import { SubCommand } from "./command.spar";
import { HelpConfig } from "./help.spar";
import { CliSettings } from "./settings.spar";

export struct Cli {
    name: str;
    version: str = "";
    about: str = "";
    longAbout: str = "";
    options: List<ArgOption> = [];
    flags: List<Flag> = [];
    positionals: List<Positional> = [];
    groups: List<ArgGroup> = [];
    commands: List<SubCommand> = [];
    help: HelpConfig = HelpConfig();
    settings: CliSettings = CliSettings();
};
