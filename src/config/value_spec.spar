export enum ValueKind {
    String,
    Int,
    Float,
    Bool
};

export enum ValueCollection {
    List,
    Single
};

// How an option or positional consumes values.
// minValues/maxValues bound the values taken per occurrence on the command
// line; maxValues = 0 means unlimited. With a delimiter, one token is split
// into several values.
export struct ValueSpec {
    kind: ValueKind = ValueKind::String;
    collection: ValueCollection = ValueCollection::Single;
    delimiter: str = "";
    minValues: int = 1;
    maxValues: int = 1;
    allowHyphenValue: bool = false;
};
