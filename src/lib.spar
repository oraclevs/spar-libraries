// spar-web: a web framework for SPAR.
//
// SPAR has no re-exports, so import each name from its own file. As a package
// (spar add web path:../spar-web) use import pkg { X } from "web/<folder>/<file>".
//
//   app/app.spar              App, AppConfig, Server (App.compile, Server.handle)
//   routing/route.spar        Route, RouteGroup
//   routing/router.spar       Router, buildRouter, matchRoute (used by App)
//   http/request.spar         Request, HttpMethod, makeRequest, parseRequest
//   http/response.spar        Response, Cookie, isLocalPath
//   http/context.spar         Context, jsonBody, requireJson
//   http/status.spar          statusOk ... , reasonPhrase
//   error/web_error.spar      WebError, WebErrorKind, notFound, badRequest, ..., raise
//   middleware/middleware.spar Middleware, middleware, composeChain
//   middleware/cors.spar      CorsConfig, cors
//   middleware/request_log.spar requestLogger, stderrLogger (spar-log)
//   static/files.spar         staticFiles, mimeType
//   transport/stdio.spar      serveStdio, parseHttpRequest, serializeResponse
fn version() -> str {
    return "0.1.0";
};
