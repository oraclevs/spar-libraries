// Reactor-backed sockets. Call from async functions; one pending read per connection.
fn listenAsync(address: str) -> AsyncTcpListenerHandle {
    return nativeTcp.listenAsync(address: address);
};

fn asyncListenerLocalAddress(listener: AsyncTcpListenerHandle) -> str {
    return nativeTcp.asyncListenerLocalAddress(listener: listener);
};

async fn acceptAsync(listener: AsyncTcpListenerHandle) -> AsyncTcpConnectionHandle {
    var accepted: int = await nativeTcp.asyncAccept(listener: listener);
    return nativeTcp.asyncTakeAccepted(listener: listener);
};

fn closeAsyncListener(listener: AsyncTcpListenerHandle) -> void {
    nativeTcp.closeAsyncListener(listener: listener);
    return;
};

async fn connectAsync(address: str, timeoutMillis: int) -> AsyncTcpConnectionHandle {
    var handle = nativeTcp.newAsyncConnect();
    var connected: int = await nativeTcp.asyncConnect(handle: handle, address: address, timeoutMillis: timeoutMillis);
    return nativeTcp.asyncTakeConnected(handle: handle);
};

async fn readAsync(connection: AsyncTcpConnectionHandle, maxBytes: int) -> Bytes {
    var count: int = await nativeTcp.asyncRead(connection: connection, maxBytes: maxBytes);
    return nativeTcp.asyncTakeRead(connection: connection);
};

async fn writeAllAsync(connection: AsyncTcpConnectionHandle, data: Bytes) -> int {
    return await nativeTcp.asyncWriteAll(connection: connection, data: data);
};

fn closeAsync(connection: AsyncTcpConnectionHandle) -> void {
    nativeTcp.closeAsyncConnection(connection: connection);
    return;
};

fn cancelAsyncAccept(listener: AsyncTcpListenerHandle) -> void { nativeTcp.cancelAsyncAccept(listener: listener); return; };
fn cancelAsyncRead(connection: AsyncTcpConnectionHandle) -> void { nativeTcp.cancelAsyncRead(connection: connection); return; };
fn cancelAsyncWrite(connection: AsyncTcpConnectionHandle) -> void { nativeTcp.cancelAsyncWrite(connection: connection); return; };
