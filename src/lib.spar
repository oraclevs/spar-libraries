    return nativeTcp.addressIsIpv6(address: address);
};

fn resolveFirst(host: str, port: int) -> str {
    return nativeTcp.resolveFirst(host: host, port: port);
};

// A byte-stream read can return fewer than maxBytes. An empty result is EOF.
fn readSome(connection: TcpConnectionHandle, maxBytes: int) -> Bytes {
    return read(connection: connection, maxBytes: maxBytes);
};

// writeBytes remains for compatibility; both operations complete the entire buffer.
fn writeAll(connection: TcpConnectionHandle, data: Bytes) -> void {
    writeBytes(connection: connection, data: data);
    return;
};

struct SocketAddress {
    ip: str;
    port: int;
};

fn parseSocketAddress(value: str) -> SocketAddress {
    return SocketAddress(ip: addressIp(address: value), port: addressPort(address: value));
};

fn formatSocketAddress(value: SocketAddress) -> str {
    if value.ip.indexOf(needle: ":").isSome() {
        return "[${value.ip}]:${value.port}";
    }
    return "${value.ip}:${value.port}";
};

fn resolveAddress(host: str, port: int) -> SocketAddress {
    return parseSocketAddress(value: resolveFirst(host: host, port: port));
};

fn connectAddress(address: SocketAddress, timeoutMillis: int) -> TcpConnectionHandle {
    return connect(address: formatSocketAddress(value: address), timeoutMillis: timeoutMillis);
};

fn newBuffer(size: int) -> Buffer {
    return nativeTcp.newBuffer(size: size);
};

fn readInto(connection: TcpConnectionHandle, buffer: Buffer) -> int {
    return nativeTcp.readInto(connection: connection, buffer: buffer);
};

fn bufferPrefix(buffer: Buffer, count: int) -> Bytes {
    return nativeTcp.bufferPrefix(buffer: buffer, count: count);
};

fn writeBuffer(connection: TcpConnectionHandle, buffer: Buffer, count: int) -> void {
    nativeTcp.writeBuffer(connection: connection, buffer: buffer, count: count);
    return;
};

fn resolveAll(host: str, port: int) -> DnsResultHandle {
    return nativeTcp.resolveAll(host: host, port: port);
};

fn resolvedCount(result: DnsResultHandle) -> int {
    return nativeTcp.resolvedCount(result: result);
};

fn resolvedAddress(result: DnsResultHandle, index: int) -> str {
    return nativeTcp.resolvedAddress(result: result, index: index);
};

fn resolveAddresses(host: str, port: int) -> [SocketAddress] {
    var result = resolveAll(host: host, port: port);
    var mut addresses: [SocketAddress] = [];
    var mut index: int = 0;
    while index < resolvedCount(result: result) {
        addresses.append(value: parseSocketAddress(value: resolvedAddress(result: result, index: index)));
        index = index + 1;
    }
    return addresses;
};

fn setLinger(connection: TcpConnectionHandle, millis: int) -> void {
    nativeTcp.setLinger(connection: connection, millis: millis);
    return;
};

