    assertEqualStr(actual: ctx.cookie(name: "session"), expected: "abc==");
    assertEqualStr(actual: ctx.cookie(name: "a"), expected: "1");
    assertEqualStr(actual: ctx.cookie(name: "b", default: "none"), expected: "none");
};

