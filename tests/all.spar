    assertEqual(actual: call(server: s, method: HttpMethod::Post, target: "/m").status, expected: 200);
    assertEqual(actual: call(server: s, method: HttpMethod::Put, target: "/m").status, expected: 200);
    assertEqual(actual: call(server: s, method: HttpMethod::Patch, target: "/m").status, expected: 200);
    assertEqual(actual: call(server: s, method: HttpMethod::Delete, target: "/m").status, expected: 200);
    assertEqual(actual: call(server: s, method: HttpMethod::Head, target: "/m").status, expected: 200);
    assertEqual(actual: call(server: s, method: HttpMethod::Options, target: "/m").status, expected: 200);
};

