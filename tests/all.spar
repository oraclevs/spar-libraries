    assertEqual(actual: get(server: s, target: "/api/").status, expected: 200);
    assertEqual(actual: get(server: s, target: "/api").status, expected: 200);
    assertEqual(actual: get(server: s, target: "//api//v1/users").status, expected: 200);
};

fn t07() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/users", handler: okText), Route.post(path: "/users", handler: okText)]));
    var r: Response = call(server: s, method: HttpMethod::Delete, target: "/users");
    assertEqual(actual: r.status, expected: 405);
    assertEqualStr(actual: r.header(name: "Allow"), expected: "GET, POST, HEAD");
    assertEqual(actual: call(server: s, method: HttpMethod::Delete, target: "/nope").status, expected: 404);
};

