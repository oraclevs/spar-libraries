    var ctx: Context = Context(request: makeRequest(method: HttpMethod::Post, target: "/", body: "name=Ada+L&x=%2B1"));
    assertEqualStr(actual: ctx.form().getOr(key: "name", fallback: ""), expected: "Ada L");
    assertEqualStr(actual: ctx.form().getOr(key: "x", fallback: ""), expected: "+1");
};

fn t29() -> void {
    assertEqual(actual: parseRequest(method: "BREW", target: "/").unwrapErr().status, expected: 501);
    assertEqual(actual: parseRequest(method: "get", target: "/").unwrapErr().status, expected: 501);
    assertEqual(actual: parseRequest(method: "GET", target: "http://evil/").unwrapErr().status, expected: 400);
};

fn t30() -> void {
    assertStringContains(actual: Response.text(value: "x").header(name: "content-type"), needle: "text/plain");
    assertStringContains(actual: Response.html(value: "<p>").header(name: "content-type"), needle: "text/html");
    var j: Response = Response.json(value: Item(id: 1, name: "a"), status: 201);
    assertEqual(actual: j.status, expected: 201);
    assertEqualStr(actual: j.body, expected: "{\"id\":1,\"name\":\"a\"}");
    assertEqual(actual: Response.empty().status, expected: 204);
    assertEqual(actual: Response.noContent().status, expected: 204);
};

fn t31() -> void {
    var r: Response = Response.redirect(location: "/login");
    assertEqual(actual: r.status, expected: 302);
    assertEqualStr(actual: r.header(name: "location"), expected: "/login");
    assertEqual(actual: Response.redirect(location: "/x", status: 308).status, expected: 308);
    assertEqual(actual: Response.redirect(location: "/x", status: 200).status, expected: 500);
    assertEqualStr(actual: Response.redirect(location: "/a\nSet-Cookie: x=1").header(name: "location"), expected: "/aSet-Cookie: x=1");
};

fn t32() -> void {
    assertTrue(actual: isLocalPath(location: "/dashboard?x=1"));
    assertFalse(actual: isLocalPath(location: "//evil.com"));
    assertFalse(actual: isLocalPath(location: "https://evil.com"));
    assertFalse(actual: isLocalPath(location: "/\\evil.com"));
    assertFalse(actual: isLocalPath(location: "login"));
};

fn t33() -> void {
    var r: Response = Response.text(value: "x").withHeader(name: "X-A", value: "v\nX-Evil: 1").withHeader(name: "X-B\n", value: "ok");
    assertFalse(actual: r.headers.containsKey(key: "x-evil"));
    assertEqualStr(actual: r.header(name: "x-a"), expected: "vX-Evil: 1");
    assertTrue(actual: r.headers.containsKey(key: "x-b"));
};

fn t34() -> void {
    assertEqualStr(actual: serializeCookie(cookie: Cookie(name: "s", value: "v")), expected: "s=v; Path=/; HttpOnly; SameSite=Lax");
    assertEqualStr(actual: serializeCookie(cookie: Cookie(name: "s", value: "v", domain: "example.com", maxAge: 60, secure: true, httpOnly: false, sameSite: "Strict")), expected: "s=v; Path=/; Domain=example.com; Max-Age=60; Secure; SameSite=Strict");
    assertStringContains(actual: serializeCookie(cookie: Cookie(name: "s", value: "v", sameSite: "None")), needle: "Secure");
    assertEqualStr(actual: serializeCookie(cookie: Cookie(name: "a b", value: "x;y\nz")), expected: "ab=xyz; Path=/; HttpOnly; SameSite=Lax");
};

fn t35() -> void {
    var r: Response = Response.text(value: "x").withCookie(cookie: Cookie(name: "a", value: "1")).withCookie(cookie: Cookie(name: "b", value: "2")).clearCookie(name: "c");
    assertEqual(actual: r.cookies.length(), expected: 3);
    assertStringContains(actual: r.cookies[2], needle: "Max-Age=0");
};

fn t36() -> void {
    assertEqual(actual: statusNotFound, expected: 404);
    assertEqualStr(actual: reasonPhrase(code: statusUnprocessableEntity), expected: "Unprocessable Entity");
};

fn t37() -> void {
    var ctx: Context = Context(request: makeRequest(method: HttpMethod::Post, target: "/", body: "{\"name\":\"Ada\",\"age\":36}"));
    var r: Result<NewUser, WebError> = jsonBody<NewUser>(ctx: ctx);
    assertTrue(actual: r.isOk());
    assertEqualStr(actual: r.unwrap().name, expected: "Ada");
    assertEqual(actual: r.unwrap().age, expected: 36);
};

fn t38() -> void {
    var r: Result<NewUser, WebError> = jsonBody<NewUser>(ctx: Context(request: makeRequest(method: HttpMethod::Post, target: "/", body: "{nope")));
    assertEqual(actual: r.unwrapErr().status, expected: 400);
    assertEqualStr(actual: r.unwrapErr().message, expected: "Invalid JSON body");
    var empty: Result<NewUser, WebError> = jsonBody<NewUser>(ctx: Context(request: makeRequest(method: HttpMethod::Post, target: "/")));
    assertEqual(actual: empty.unwrapErr().status, expected: 400);
};

fn t39() -> void {
    var r: Result<NewUser, WebError> = jsonBody<NewUser>(ctx: Context(request: makeRequest(method: HttpMethod::Post, target: "/", body: "{\"name\":\"a\",\"age\":\"x\"}")));
    assertEqual(actual: r.unwrapErr().status, expected: 422);
    assertEqualStr(actual: r.unwrapErr().metadata.getOr(key: "field", fallback: ""), expected: "age");
    assertStringContains(actual: r.unwrapErr().message, needle: "expected int");
};

fn t40() -> void {
    var s: Server = build(app: App(routes: [Route.post(path: "/n", handler: fn(ctx: Context) -> Response { var u: NewUser = requireJson<NewUser>(ctx: ctx); return Response.text(value: u.name); })]));
    assertEqualStr(actual: call(server: s, method: HttpMethod::Post, target: "/n", body: "{\"name\":\"Ada\"}").body, expected: "Ada");
    var bad: Response = call(server: s, method: HttpMethod::Post, target: "/n", body: "oops");
    assertEqual(actual: bad.status, expected: 400);
    assertStringContains(actual: bad.body, needle: "Invalid JSON body");
};

fn t41() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/e", handler: fn(ctx: Context) -> Response { return Response.fail(error: conflict(message: "taken")); })]));
    var r: Response = get(server: s, target: "/e");
    assertEqual(actual: r.status, expected: 409);
    assertStringContains(actual: r.body, needle: "taken");
};

fn t42() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/e", handler: fn(ctx: Context) -> Response { return Response.fail(error: forbidden()); })], errorHandler: fn(error: WebError) -> Response { return Response.text(value: "E:" + error.status.toString() + ":" + error.message, status: error.status); }));
    assertEqualStr(actual: get(server: s, target: "/e").body, expected: "E:403:Forbidden");
    assertEqualStr(actual: get(server: s, target: "/missing").body, expected: "E:404:Not Found");
    assertEqualStr(actual: call(server: s, method: HttpMethod::Post, target: "/e").body, expected: "E:405:Method Not Allowed");
};

fn t43() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/boom", handler: fn(ctx: Context) -> Response { var z: int = 0; return Response.text(value: (1 / z).toString()); })]));
    var r: Response = get(server: s, target: "/boom");
    assertEqual(actual: r.status, expected: 500);
    assertStringContains(actual: r.body, needle: "Internal Server Error");
    assertFalse(actual: r.body.contains(needle: "zero"));
};

fn t44() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/boom", handler: fn(ctx: Context) -> Response { var z: int = 0; return Response.text(value: (1 / z).toString()); })], config: AppConfig(developmentMode: true)));
    assertStringContains(actual: get(server: s, target: "/boom").body, needle: "zero");
};

fn t45() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/ok", handler: okText)], middleware: [middleware(name: "bad", run: fn(ctx: Context, next: fn(Context) -> Response) -> Response { raise(error: unauthorized()); return next(arg0: ctx); })]));
    assertEqual(actual: get(server: s, target: "/ok").status, expected: 401);
};

fn t46() -> void {
    var s: Server = build(app: App(routes: [Route.post(path: "/p", handler: okText)], config: AppConfig(requestBodyLimit: 5)));
    assertEqual(actual: call(server: s, method: HttpMethod::Post, target: "/p", body: "12345").status, expected: 200);
    assertEqual(actual: call(server: s, method: HttpMethod::Post, target: "/p", body: "123456").status, expected: 413);
};

fn t47() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/c", handler: okText)], middleware: [cors(config: CorsConfig(allowedOrigins: ["https://app.example.com"], allowCredentials: true, exposedHeaders: ["x-total"]))]));
    var r: Response = call(server: s, method: HttpMethod::Get, target: "/c", headers: { Origin: "https://app.example.com"; });
    assertEqualStr(actual: r.header(name: "access-control-allow-origin"), expected: "https://app.example.com");
    assertEqualStr(actual: r.header(name: "access-control-allow-credentials"), expected: "true");
    assertStringContains(actual: r.header(name: "vary"), needle: "Origin");
    assertEqualStr(actual: r.header(name: "access-control-expose-headers"), expected: "x-total");
};

fn t48() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/c", handler: okText)], middleware: [cors(config: CorsConfig(allowedOrigins: ["https://app.example.com"]))]));
    var r: Response = call(server: s, method: HttpMethod::Get, target: "/c", headers: { Origin: "https://evil.example"; });
    assertEqual(actual: r.status, expected: 200);
    assertFalse(actual: r.headers.containsKey(key: "access-control-allow-origin"));
};

fn t49() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/c", handler: okText)], middleware: [cors(config: CorsConfig())]));
    assertFalse(actual: get(server: s, target: "/c").headers.containsKey(key: "access-control-allow-origin"));
};

fn t50() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/c", handler: okText)], middleware: [cors(config: CorsConfig())]));
    var r: Response = call(server: s, method: HttpMethod::Get, target: "/c", headers: { Origin: "https://any.example"; });
    assertEqualStr(actual: r.header(name: "access-control-allow-origin"), expected: "*");
    assertFalse(actual: r.headers.containsKey(key: "access-control-allow-credentials"));
};

fn t51() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/c", handler: okText)], middleware: [cors(config: CorsConfig(allowedOrigins: ["https://app.example.com"]))]));
    var r: Response = call(server: s, method: HttpMethod::Options, target: "/anything", headers: hdrs(k1: "Origin", v1: "https://app.example.com", k2: "Access-Control-Request-Method", v2: "PUT", k3: "Access-Control-Request-Headers", v3: "content-type"));
    assertEqual(actual: r.status, expected: 204);
    assertEqualStr(actual: r.header(name: "access-control-allow-origin"), expected: "https://app.example.com");
    assertStringContains(actual: r.header(name: "access-control-allow-methods"), needle: "PUT");
    assertEqualStr(actual: r.header(name: "access-control-allow-headers"), expected: "content-type");
    assertEqualStr(actual: r.header(name: "access-control-max-age"), expected: "600");
};

fn t52() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/c", handler: okText)], middleware: [cors(config: CorsConfig(allowedOrigins: ["https://app.example.com"], allowedMethods: ["GET"]))]));
    var origin: Response = call(server: s, method: HttpMethod::Options, target: "/c", headers: hdrs(k1: "Origin", v1: "https://evil.example", k2: "Access-Control-Request-Method", v2: "GET"));
    assertEqual(actual: origin.status, expected: 403);
    var method: Response = call(server: s, method: HttpMethod::Options, target: "/c", headers: hdrs(k1: "Origin", v1: "https://app.example.com", k2: "Access-Control-Request-Method", v2: "DELETE"));
    assertEqual(actual: method.status, expected: 403);
};

fn t53() -> void {
    var r: Result<Server, WebError> = App(middleware: [cors(config: CorsConfig(allowCredentials: true))]).compile();
    assertTrue(actual: r.isErr());
    assertStringContains(actual: r.unwrapErr().message, needle: "allowCredentials");
};

fn t54() -> void {
    var path: str = absolute(path: "request.log.tmp");
    if exists(path: path) { removeFile(path: path); }
    var logger: Logger = Logger(name: "t", config: LoggerConfig(sinks: [Sink(kind: SinkKind::File, path: path, formatter: Formatter(style: FormatStyle::Compact, showTimestamp: false))]));
    var s: Server = build(app: App(routes: [Route.get(path: "/ping", handler: okText)], middleware: [requestLogger(logger: logger)]));
    get(server: s, target: "/ping");
    get(server: s, target: "/nope");
    var text: str = readText(path: path);
    removeFile(path: path);
    assertStringContains(actual: text, needle: "GET /ping 200");
    assertStringContains(actual: text, needle: "GET /nope 404");
    assertStringContains(actual: text, needle: "ms");
};

fn t55() -> void {
    setupStatic();
    var s: Server = build(app: App(routes: [staticFiles(prefix: "/public", dir: "static_tmp/public")]));
    var r: Response = get(server: s, target: "/public/index.html");
    assertEqual(actual: r.status, expected: 200);
    assertStringContains(actual: r.body, needle: "hello static");
    assertStringContains(actual: r.header(name: "content-type"), needle: "text/html");
    assertStringContains(actual: get(server: s, target: "/public/css/site.css").header(name: "content-type"), needle: "text/css");
    assertEqual(actual: get(server: s, target: "/public/missing.txt").status, expected: 404);
    teardownStatic();
};

fn t56() -> void {
    setupStatic();
    var s: Server = build(app: App(routes: [staticFiles(prefix: "/public", dir: "static_tmp/public")]));
    assertEqual(actual: get(server: s, target: "/public/../secret.txt").status, expected: 404);
    assertEqual(actual: get(server: s, target: "/public/%2e%2e/secret.txt").status, expected: 404);
    assertEqual(actual: get(server: s, target: "/public/%2e%2e%2fsecret.txt").status, expected: 404);
    assertEqual(actual: get(server: s, target: "/public/css/../../secret.txt").status, expected: 404);
    assertEqual(actual: get(server: s, target: "/public/..%5csecret.txt").status, expected: 404);
    assertEqual(actual: get(server: s, target: "/public/.hidden").status, expected: 404);
    assertEqual(actual: get(server: s, target: "/public//etc/passwd").status, expected: 404);
    assertFalse(actual: get(server: s, target: "/public/../secret.txt").body.contains(needle: "top secret"));
    teardownStatic();
};

fn t57() -> void {
    assertEqualStr(actual: resolveStatic(dir: "tests", relative: "../x"), expected: "");
    assertEqualStr(actual: resolveStatic(dir: "tests", relative: "a/../../x"), expected: "");
    assertEqualStr(actual: mimeType(ext: "SVG"), expected: "image/svg+xml");
    assertEqualStr(actual: mimeType(ext: "woff2"), expected: "font/woff2");
    assertEqualStr(actual: mimeType(ext: "zzz"), expected: "application/octet-stream");
    assertTrue(actual: isSafeRelative(relative: "a/b.txt"));
    assertFalse(actual: isSafeRelative(relative: "a/.env"));
};

fn t58() -> void {
    var raw: str = "POST /u?x=1 HTTP/1.1" + crlf() + "Host: h" + crlf() + "X-A: 1" + crlf() + crlf() + "{\"a\":1}";
    var req: Request = parseHttpRequest(raw: raw).unwrap();
    assertEqualStr(actual: req.path, expected: "/u");
    assertEqualStr(actual: req.rawQuery, expected: "x=1");
    assertEqualStr(actual: req.headers.getOr(key: "x-a", fallback: ""), expected: "1");
    assertEqualStr(actual: req.body, expected: "{\"a\":1}");
    assertTrue(actual: parseHttpRequest(raw: "garbage" + crlf() + crlf()).isErr());
    var wire: str = serializeResponse(response: Response.text(value: "hi", status: 201).withCookie(cookie: Cookie(name: "a", value: "1")));
    assertStringContains(actual: wire, needle: "HTTP/1.1 201 Created");
    assertStringContains(actual: wire, needle: "set-cookie: a=1");
    assertTrue(actual: wire.endsWith(suffix: crlf() + crlf() + "hi"));
};

fn t59() -> void {
    var r: Result<int, WebError> = App().listen();
    assertTrue(actual: r.isErr());
    assertStringContains(actual: r.unwrapErr().message, needle: "listener");
};

fn tLogErrors() -> void {
    var path: str = absolute(path: "errors.log.tmp");
    if exists(path: path) { removeFile(path: path); }
    var logger: Logger = Logger(name: "t", config: LoggerConfig(sinks: [Sink(kind: SinkKind::File, path: path, formatter: Formatter(style: FormatStyle::Compact, showTimestamp: false))]));
    var s: Server = build(app: App(routes: [Route.get(path: "/boom", handler: fn(ctx: Context) -> Response { var z: int = 0; return Response.text(value: (1 / z).toString()); }), Route.get(path: "/nf", handler: okText)], config: AppConfig(logErrors: true, logger: logger)));
    get(server: s, target: "/boom");
    get(server: s, target: "/missing");
    var text: str = readText(path: path);
    removeFile(path: path);
    assertStringContains(actual: text, needle: "request failed");
    assertStringContains(actual: text, needle: "zero");
    assertFalse(actual: text.contains(needle: "Not Found"));
};

fn main() -> int {
    var suite: TestSuite = TestSuite(name: "spar-web", tests: [
        Test(name: "static route matches", run: t00),
        Test(name: "route parameters are extracted", run: t01),
        Test(name: "params are percent-decoded", run: t02),
        Test(name: "static beats param regardless of order", run: t03),
        Test(name: "first differing segment decides precedence", run: t04),
        Test(name: "wildcard captures the tail", run: t05),
        Test(name: "trailing and repeated slashes are ignored", run: t06),
        Test(name: "405 lists allowed methods", run: t07),
        Test(name: "405 also covers param routes", run: t08),
        Test(name: "method falls through to a param route", run: t09),
        Test(name: "all seven methods route", run: t10),
        Test(name: "HEAD falls back to GET without a body", run: t11),
        Test(name: "OPTIONS on a known path answers with Allow", run: t12),
        Test(name: "duplicate routes are rejected at compile", run: t13),
        Test(name: "same shape with different param names is a duplicate", run: t14),
        Test(name: "same path with different methods is fine", run: t15),
        Test(name: "malformed route patterns are rejected", run: t16),
        Test(name: "all config problems are reported together", run: t17),
        Test(name: "custom 404 handler", run: t18),
        Test(name: "default 404 is a JSON error", run: t19),
        Test(name: "groups add prefixes and nest", run: t20),
        Test(name: "group middleware wraps group routes only, outer first", run: t21),
        Test(name: "global middleware runs in order around the handler", run: t22),
        Test(name: "middleware can short-circuit", run: t23),
        Test(name: "middleware sees 404 and can pass data to the handler", run: t24),
        Test(name: "query parameters", run: t25),
        Test(name: "headers are case-insensitive", run: t26),
        Test(name: "cookies are parsed from the Cookie header", run: t27),
        Test(name: "form bodies are decoded", run: t28),
        Test(name: "unknown methods are rejected", run: t29),
        Test(name: "text, html, json and empty responses", run: t30),
        Test(name: "redirects", run: t31),
        Test(name: "redirect target check", run: t32),
        Test(name: "header values cannot inject lines", run: t33),
        Test(name: "cookies are serialized with safe defaults", run: t34),
        Test(name: "responses carry several cookies", run: t35),
        Test(name: "status helpers", run: t36),
        Test(name: "typed JSON body decodes into a struct", run: t37),
        Test(name: "malformed JSON is 400", run: t38),
        Test(name: "wrong field type is 422 and names the field", run: t39),
        Test(name: "requireJson turns bad input into a 400 response", run: t40),
        Test(name: "Response.fail is rendered by the error handler", run: t41),
        Test(name: "custom error handler renders every error", run: t42),
        Test(name: "runtime errors become 500 without leaking details", run: t43),
        Test(name: "development mode includes the cause", run: t44),
        Test(name: "errors thrown by global middleware are still handled", run: t45),
        Test(name: "oversized bodies get 413", run: t46),
        Test(name: "CORS: simple request from an allowed origin", run: t47),
        Test(name: "CORS: disallowed origin gets no CORS headers", run: t48),
        Test(name: "CORS: no Origin header means no CORS headers", run: t49),
        Test(name: "CORS: wildcard origin", run: t50),
        Test(name: "CORS: preflight is answered without reaching the route", run: t51),
        Test(name: "CORS: preflight for a disallowed origin or method is 403", run: t52),
        Test(name: "CORS: wildcard with credentials is a compile error", run: t53),
        Test(name: "request logger writes method, path, status and time through spar-log", run: t54),
        Test(name: "static files: serves text files with a MIME type", run: t55),
        Test(name: "static files: path traversal is refused", run: t56),
        Test(name: "static files: helpers", run: t57),
        Test(name: "stdio transport parses and serializes HTTP/1.1", run: t58),
        Test(name: "5xx causes are logged through spar-log when enabled", run: tLogErrors),
        Test(name: "listen reports the missing native listener", run: t59)
    ]);
    return runMain(suites: [suite]);
};
