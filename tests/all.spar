fn t20() -> void {
    var s: Server = build(app: App(groups: [RouteGroup(prefix: "/api", routes: [Route.get(path: "/health", handler: patternOf)], groups: [RouteGroup(prefix: "v1/", routes: [Route.get(path: "/users/:id", handler: patternOf)])])]));
    assertEqualStr(actual: get(server: s, target: "/api/health").body, expected: "/api/health");
    assertEqualStr(actual: get(server: s, target: "/api/v1/users/5").body, expected: "/api/v1/users/:id");
    assertEqual(actual: get(server: s, target: "/health").status, expected: 404);
};

fn t21() -> void {
    var s: Server = build(app: App(
        routes: [Route.get(path: "/open", handler: traceHandler)],
        groups: [RouteGroup(prefix: "/g", middleware: [tracer(label: "G1"), tracer(label: "G2")], routes: [Route.get(path: "/x", handler: traceHandler, middleware: [tracer(label: "R")])])],
    ));
    assertEqualStr(actual: get(server: s, target: "/g/x").body, expected: "G1>G2>R>");
    assertEqualStr(actual: get(server: s, target: "/g/x").header(name: "x-after"), expected: "<R<G2<G1");
    assertEqualStr(actual: get(server: s, target: "/open").body, expected: "");
};

fn t22() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/t", handler: traceHandler)], middleware: [tracer(label: "A"), tracer(label: "B"), tracer(label: "C")]));
    var r: Response = get(server: s, target: "/t");
    assertEqualStr(actual: r.body, expected: "A>B>C>");
    assertEqualStr(actual: r.header(name: "x-after"), expected: "<C<B<A");
};

fn t23() -> void {
    var gate: Middleware = middleware(name: "gate", run: fn(ctx: Context, next: fn(Context) -> Response) -> Response { return Response.text(value: "stopped", status: 403); });
    var s: Server = build(app: App(routes: [Route.get(path: "/t", handler: traceHandler)], middleware: [tracer(label: "A"), gate, tracer(label: "C")]));
    var r: Response = get(server: s, target: "/t");
    assertEqual(actual: r.status, expected: 403);
    assertEqualStr(actual: r.body, expected: "stopped");
    assertEqualStr(actual: r.header(name: "x-after"), expected: "<A");
};

fn t24() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/who", handler: fn(ctx: Context) -> Response { return Response.text(value: ctx.local(name: "user", default: "none")); })], middleware: [middleware(name: "u", run: fn(ctx: Context, next: fn(Context) -> Response) -> Response { return next(arg0: ctx.withLocal(name: "user", value: "ada")).withHeader(name: "x-seen", value: "yes"); })]));
    assertEqualStr(actual: get(server: s, target: "/who").body, expected: "ada");
    assertEqualStr(actual: get(server: s, target: "/missing").header(name: "x-seen"), expected: "yes");
};

fn t25() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/search", handler: fn(ctx: Context) -> Response { return Response.text(value: ctx.query(name: "q") + "|" + ctx.queryInt(name: "page", default: 1).toString() + "|" + ctx.queryAll(name: "tag").join(separator: ",") + "|" + ctx.query(name: "none", default: "d") + "|" + ctx.hasQuery(name: "q").toString()); })]));
    assertEqualStr(actual: get(server: s, target: "/search?q=spar+web&page=2&tag=rust&tag=spar").body, expected: "spar web|2|rust,spar|d|true");
    assertEqualStr(actual: get(server: s, target: "/search?page=abc").body, expected: "|1||d|false");
    assertEqualStr(actual: get(server: s, target: "/search?q=%41%2f").body, expected: "A/|1||d|true");
};

