};

fn t10() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/m", handler: okText), Route.post(path: "/m", handler: okText), Route.put(path: "/m", handler: okText), Route.patch(path: "/m", handler: okText), Route.delete(path: "/m", handler: okText), Route.head(path: "/m", handler: okText), Route.options(path: "/m", handler: okText)]));
