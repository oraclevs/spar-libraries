struct Item {
    id: int = 0;
    name: str = "";
};

struct NewUser {
    name: str = "";
    age: int = 0;
};

// Middleware that appends its label to a "trace" local before the handler and
// to the x-after header after it, so order is observable.
fn tracer(label: str) -> Middleware {
    return middleware(name: label, run: fn(ctx: Context, next: fn(Context) -> Response) -> Response {
        var res: Response = next(arg0: ctx.withLocal(name: "trace", value: ctx.local(name: "trace") + label + ">"));
        return res.withHeader(name: "x-after", value: res.header(name: "x-after") + "<" + label);
    });
};

fn traceHandler(ctx: Context) -> Response {
    return Response.text(value: ctx.local(name: "trace"));
};

fn setupStatic() -> void {
    teardownStatic();
    createDir(path: "static_tmp/public/css", recursive: true);
    writeText(path: "static_tmp/public/index.html", content: "<h1>hello static</h1>");
    writeText(path: "static_tmp/public/css/site.css", content: "body{}");
    writeText(path: "static_tmp/public/.hidden", content: "hidden");
    writeText(path: "static_tmp/secret.txt", content: "top secret");
};

fn teardownStatic() -> void {
    if exists(path: "static_tmp") {
        removeDir(path: "static_tmp", recursive: true);
    }
};

fn t00() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/", handler: okText), Route.get(path: "/health", handler: okText), Route.get(path: "/users/profile", handler: okText)]));
    assertEqual(actual: get(server: s, target: "/").status, expected: 200);
    assertEqual(actual: get(server: s, target: "/health").status, expected: 200);
    assertEqual(actual: get(server: s, target: "/users/profile").status, expected: 200);
    assertEqual(actual: get(server: s, target: "/users").status, expected: 404);
    assertEqual(actual: get(server: s, target: "/health/x").status, expected: 404);
};

fn t01() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/users/:id", handler: echoParams), Route.get(path: "/posts/:post/comments/:comment", handler: echoParams)]));
    assertEqualStr(actual: get(server: s, target: "/users/42").body, expected: "/users/:id|id=42");
    assertEqualStr(actual: get(server: s, target: "/posts/7/comments/9").body, expected: "/posts/:post/comments/:comment|post=7,comment=9");
    assertEqual(actual: get(server: s, target: "/users").status, expected: 404);
    assertEqual(actual: get(server: s, target: "/users/1/extra").status, expected: 404);
};

fn t02() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/n/:name", handler: echoParams)]));
    assertEqualStr(actual: get(server: s, target: "/n/a%20b").body, expected: "/n/:name|name=a b");
};

fn t03() -> void {
    var a: Server = build(app: App(routes: [Route.get(path: "/users/me", handler: patternOf), Route.get(path: "/users/:id", handler: patternOf)]));
    var b: Server = build(app: App(routes: [Route.get(path: "/users/:id", handler: patternOf), Route.get(path: "/users/me", handler: patternOf)]));
    assertEqualStr(actual: get(server: a, target: "/users/me").body, expected: "/users/me");
    assertEqualStr(actual: get(server: b, target: "/users/me").body, expected: "/users/me");
    assertEqualStr(actual: get(server: b, target: "/users/you").body, expected: "/users/:id");
};

fn t04() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/a/:x/c", handler: patternOf), Route.get(path: "/a/b/:y", handler: patternOf), Route.get(path: "/*rest", handler: patternOf)]));
    assertEqualStr(actual: get(server: s, target: "/a/b/c").body, expected: "/a/b/:y");
    assertEqualStr(actual: get(server: s, target: "/a/z/c").body, expected: "/a/:x/c");
    assertEqualStr(actual: get(server: s, target: "/other/deep/path").body, expected: "/*rest");
};

fn t05() -> void {
    var s: Server = build(app: App(routes: [Route.get(path: "/files/*path", handler: echoParams)]));
    assertEqualStr(actual: get(server: s, target: "/files/a/b/c.txt").body, expected: "/files/*path|path=a/b/c.txt");
    assertEqual(actual: get(server: s, target: "/files").status, expected: 404);
};

fn t06() -> void {
