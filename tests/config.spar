import { Cli } from "../src/config/cli.spar";
import { SubCommand } from "../src/config/command.spar";
import { ArgOption } from "../src/config/option.spar";
import { Flag } from "../src/config/flag.spar";
import { Positional } from "../src/config/positional.spar";
import { ArgGroup } from "../src/config/group.spar";
import { ParseError, ParseErrorKind } from "../src/result/parse_error.spar";
import { checkCli } from "../src/parser/validate.spar";
import {
    check,
    report,
    failsWith,
    errorOf
} from "./support.spar";

fn mentions(problems: List<str>, text: str) -> bool {
    for problem in problems {
        if problem.contains(needle: text) {
            return true;
        }
    }
    return false;
};

fn definitions() -> int {
    var mut failed: int = 0;
    var fine: Cli = Cli(
        name: "ok",
        flags: [Flag(name: "a", short: "a")],
        commands: [SubCommand(name: "x"), SubCommand(name: "y", path: ["x"])],
    );
    failed = failed + check(
        label: "a valid CLI has no problems",
        condition: checkCli(cli: fine).length() == 0,
    );
    failed = failed + check(
        label: "unnamed CLI",
        condition: mentions(
            problems: checkCli(cli: Cli(name: "")),
            text: "no name",
        ),
    );
    var twice: Cli = Cli(
        name: "t",
        flags: [Flag(name: "a", short: "a")],
        options: [ArgOption(name: "a", long: "a")],
    );
    failed = failed + check(
        label: "duplicate argument names",
        condition: mentions(
            problems: checkCli(cli: twice),
            text: "used more than once",
        ),
    );
    var bare: Cli = Cli(name: "t", options: [ArgOption(name: "o")]);
    failed = failed + check(
        label: "option without spelling",
        condition: mentions(
            problems: checkCli(cli: bare),
            text: "needs a short or long spelling",
        ),
    );
    var longShort: Cli = Cli(name: "t", flags: [Flag(name: "f", short: "ff")]);
    failed = failed + check(
        label: "multi-character short",
        condition: mentions(
            problems: checkCli(cli: longShort),
            text: "one character",
        ),
    );
    var dangling: Cli = Cli(
        name: "t",
        flags: [Flag(name: "f", short: "f", requires: ["ghost"])],
    );
    failed = failed + check(
        label: "requires an unknown argument",
        condition: mentions(problems: checkCli(cli: dangling), text: "ghost"),
    );
    var badGroup: Cli = Cli(
        name: "t",
        flags: [Flag(name: "f", short: "f")],
        groups: [ArgGroup(name: "g", members: ["f", "nope"])],
    );
    failed = failed + check(
        label: "group with an unknown member",
        condition: mentions(problems: checkCli(cli: badGroup), text: "nope"),
    );
    var orphan: Cli = Cli(
        name: "t",
        commands: [SubCommand(name: "child", path: ["missing"])],
    );
    failed = failed + check(
        label: "command whose parent does not exist",
        condition: mentions(
            problems: checkCli(cli: orphan),
            text: "parent command is not defined",
        ),
    );
    var repeated: Cli = Cli(
        name: "t",
        commands: [SubCommand(name: "go"), SubCommand(name: "go")],
    );
    failed = failed + check(
        label: "command defined twice",
        condition: mentions(
            problems: checkCli(cli: repeated),
            text: "defined more than once",
        ),
    );
    var shadow: Cli = Cli(
        name: "t",
        flags: [Flag(name: "v", short: "v", global: true)],
        commands: [
            SubCommand(name: "c", flags: [Flag(name: "v", short: "v")])
        ],
    );
    failed = failed + check(
        label: "a command may not redefine a global",
        condition: mentions(
            problems: checkCli(cli: shadow),
            text: "used more than once",
        ),
    );
    return failed;
};

fn parsing() -> int {
    var mut failed: int = 0;
    var broken: Cli = Cli(name: "t", options: [ArgOption(name: "o")]);
    failed = failed + check(
        label: "parse refuses a broken definition",
        condition: failsWith(
            cli: broken,
            argv: [],
            kind: ParseErrorKind::InvalidConfiguration,
        ),
    );
    var error: ParseError = errorOf(cli: broken, argv: []);
    failed = failed + check(
        label: "and says why",
        condition: error.message.contains(needle: "invalid CLI definition"),
    );
    return failed;
};

fn main() -> int {
    var mut bad: int = 0;
    bad = bad + report(
        suite: "CLI definition checks",
        failures: definitions(),
    );
    bad = bad + report(
        suite: "invalid definitions at parse time",
        failures: parsing(),
    );
    return bad;
};
